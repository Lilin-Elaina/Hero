  61:remote/rc_dbus.c **** void RC_Init(void)
  62:remote/rc_dbus.c **** {
  63:remote/rc_dbus.c ****     memset(&RC_Data, 0, sizeof(RC_Data));
  64:remote/rc_dbus.c ****     RC_Data.online = 0;
  65:remote/rc_dbus.c ****     RC_Data.sw_swap = 1u;
