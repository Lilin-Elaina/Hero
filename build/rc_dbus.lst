 146:remote/rc_dbus.c **** {
 147:remote/rc_dbus.c ****     /* ---- 4 路摇杆 × 11bit，LSB 先 / 小端顺序打包 ---- */
 148:remote/rc_dbus.c ****     RC_Data.ch[0] = (uint16_t)(b[0]            | ((uint16_t)b[1] << 8))                 & 0x07FF;
 149:remote/rc_dbus.c ****     RC_Data.ch[1] = (uint16_t)((b[1] >> 3)     | ((uint16_t)b[2] << 5))                 & 0x07FF;
 150:remote/rc_dbus.c ****     RC_Data.ch[2] = (uint16_t)((b[2] >> 6)     | ((uint16_t)b[3] << 2) | ((uint16_t)b[4] << 10)) & 
 151:remote/rc_dbus.c ****     RC_Data.ch[3] = (uint16_t)((b[4] >> 1)     | ((uint16_t)b[5] << 7))                 & 0x07FF;
 152:remote/rc_dbus.c **** 
 153:remote/rc_dbus.c ****     /* ---- 2 路拨杆，各 2bit，放在 b[5] 的高 4 位 ----
 154:remote/rc_dbus.c ****      * 与官方 RC_ctrl_t.s[] 的对应关系（位运算不动，命名靠 sw_swap 调）：
 155:remote/rc_dbus.c ****      *   sw_lo2 = (b[5]>>4)&0x03       = 官方 s[0]（bit4~5）
 156:remote/rc_dbus.c ****      *   sw_hi2 = ((b[5]>>4)&0x0C)>>2  = 官方 s[1]（bit6~7）
 157:remote/rc_dbus.c ****      * 官方 s[0]/s[1] 哪个是物理左拨杆有版本分歧，用 sw_swap 一次性量准
 158:remote/rc_dbus.c ****      * （见 rc_dbus.h 的 ★验证法，位运算本身不用动）*/
 159:remote/rc_dbus.c ****     RC_Data.sw_lo2 = RC_SW_BITS_LO(b[5]);
 160:remote/rc_dbus.c ****     RC_Data.sw_hi2 = RC_SW_BITS_HI(b[5]);
 161:remote/rc_dbus.c **** 
 162:remote/rc_dbus.c ****     /* ---- 拨杆位域自动判定：必须在下面的命名映射之前调用，判定结果当
 163:remote/rc_dbus.c ****      * 实测法（上电后 3 秒内做一次即可）：把左拨杆停在“上”或“下”�
 164:remote/rc_dbus.c ****      * 保持右拨杆在中位不动，持续约 1 秒 → sw_auto_done 变 1、sw_swap 自动定�
 165:remote/rc_dbus.c ****     RC_SwitchAutoName();
 166:remote/rc_dbus.c **** 
 167:remote/rc_dbus.c ****     if (RC_Data.sw_swap)
