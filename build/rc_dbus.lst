 169:remote/rc_dbus.c ****         RC_Data.s_left  = RC_Data.sw_hi2;
 170:remote/rc_dbus.c ****         RC_Data.s_right = RC_Data.sw_lo2;
 171:remote/rc_dbus.c ****     }
 172:remote/rc_dbus.c ****     else
 173:remote/rc_dbus.c ****     {
