 147:remote/rc_dbus.c **** void RC_Decode(uint8_t *b)
 148:remote/rc_dbus.c **** {
 149:remote/rc_dbus.c ****     /* ---- 4 路摇杆 × 11bit，LSB 先 / 小端顺序打包 ---- */
 150:remote/rc_dbus.c ****     RC_Data.ch[0] = (uint16_t)(b[0]            | ((uint16_t)b[1] << 8))                 & 0x07FF;
 151:remote/rc_dbus.c ****     RC_Data.ch[1] = (uint16_t)((b[1] >> 3)     | ((uint16_t)b[2] << 5))                 & 0x07FF;
 152:remote/rc_dbus.c ****     RC_Data.ch[2] = (uint16_t)((b[2] >> 6)     | ((uint16_t)b[3] << 2) | ((uint16_t)b[4] << 10)) & 
 153:remote/rc_dbus.c ****     RC_Data.ch[3] = (uint16_t)((b[4] >> 1)     | ((uint16_t)b[5] << 7))                 & 0x07FF;
 154:remote/rc_dbus.c **** 
 155:remote/rc_dbus.c ****     /* ---- 2 路拨杆，各 2bit，放在 b[5] 的高 4 位 ----
 156:remote/rc_dbus.c ****      * 与官方 RC_ctrl_t.s[] 的对应关系（位运算不动，命名靠 sw_swap 调）：
 157:remote/rc_dbus.c ****      *   sw_lo2 = (b[5]>>4)&0x03       = 官方 s[0]（bit4~5）
 158:remote/rc_dbus.c ****      *   sw_hi2 = ((b[5]>>4)&0x0C)>>2  = 官方 s[1]（bit6~7）
 159:remote/rc_dbus.c ****      * 官方 s[0]/s[1] 哪个是物理左拨杆有版本分歧，用 sw_swap 一次性量准
 160:remote/rc_dbus.c ****      * （见 rc_dbus.h 的 ★验证法，位运算本身不用动）*/
 161:remote/rc_dbus.c ****     RC_Data.sw_lo2 = RC_SW_BITS_LO(b[5]);
 162:remote/rc_dbus.c ****     RC_Data.sw_hi2 = RC_SW_BITS_HI(b[5]);
 163:remote/rc_dbus.c **** 
 164:remote/rc_dbus.c ****     /* ---- 拨杆位域自动判定：必须在下面的命名映射之前调用，判定结果当
 165:remote/rc_dbus.c ****      * 实测法（上电后 3 秒内做一次即可）：把左拨杆停在“上”或“下”�
 166:remote/rc_dbus.c ****      * 保持右拨杆在中位不动，持续约 1 秒 → sw_auto_done 变 1、sw_swap 自动定�
 167:remote/rc_dbus.c ****     RC_SwitchAutoName();
 168:remote/rc_dbus.c **** 
 169:remote/rc_dbus.c ****     if (RC_Data.sw_swap)
 170:remote/rc_dbus.c ****     {
 171:remote/rc_dbus.c ****         RC_Data.s_left  = RC_Data.sw_hi2;
 172:remote/rc_dbus.c ****         RC_Data.s_right = RC_Data.sw_lo2;
 173:remote/rc_dbus.c ****     }
 174:remote/rc_dbus.c ****     else
 175:remote/rc_dbus.c ****     {
 176:remote/rc_dbus.c ****         RC_Data.s_left  = RC_Data.sw_lo2;
 177:remote/rc_dbus.c ****         RC_Data.s_right = RC_Data.sw_hi2;
 178:remote/rc_dbus.c ****     }
 179:remote/rc_dbus.c **** 
 180:remote/rc_dbus.c ****     /* ---- 鼠标 + 键盘（完整解出，保证整帧 18 字节全覆盖）----
 181:remote/rc_dbus.c ****      * 控制层暂不使用，但解出后可在调试器里核验通信正确性 */
 182:remote/rc_dbus.c ****     RC_Data.mouse.x        = (int16_t)(b[6]  | ((uint16_t)b[7]  << 8));
 183:remote/rc_dbus.c ****     RC_Data.mouse.y        = (int16_t)(b[8]  | ((uint16_t)b[9]  << 8));
 184:remote/rc_dbus.c ****     RC_Data.mouse.z        = (int16_t)((b[10] | ((uint16_t)b[11] << 8)) & 0x07FF); /* 官方未掩�
 185:remote/rc_dbus.c ****     RC_Data.mouse.press_l  = b[12];
 186:remote/rc_dbus.c ****     RC_Data.mouse.press_r  = b[13];
 187:remote/rc_dbus.c ****     RC_Data.key_v          = b[14];
 188:remote/rc_dbus.c ****     RC_Data.key_h          = b[15];
 189:remote/rc_dbus.c **** 
 190:remote/rc_dbus.c ****     /* ---- 左拨轮：11bit。官方 sbus_to_rc 未对 wheel 掩码；
 191:remote/rc_dbus.c ****      * 此处 &0x07FF 为防御性加固——切掉 b[17] 高 5 位未定义脏位，
 192:remote/rc_dbus.c ****      * 合法帧恒等、异常帧不会把脏位当有效值 ---- */
 193:remote/rc_dbus.c ****     RC_Data.wheel = (uint16_t)((b[16] | ((uint16_t)b[17] << 8)) & 0x07FF);
 194:remote/rc_dbus.c **** 
 195:remote/rc_dbus.c ****     {
 196:remote/rc_dbus.c ****         uint32_t now = HAL_GetTick();
 197:remote/rc_dbus.c **** 
 198:remote/rc_dbus.c ****         /* 两帧间隔统计：RC_GapMaxMs > 100 就是一次实打实的“准失联”，
 199:remote/rc_dbus.c ****          * 这比 online 标志可信——online 只看最后一帧距今，间隔大不大它不�
 200:remote/rc_dbus.c ****         if ((RC_Data.last_tick != 0u) && ((now - RC_Data.last_tick) > RC_GapMaxMs))
 201:remote/rc_dbus.c ****         {
 202:remote/rc_dbus.c ****             RC_GapMaxMs = now - RC_Data.last_tick;
ARM GAS  C:\Users\elaina\AppData\Local\Temp\cc9evgfd.s 			page 5


 203:remote/rc_dbus.c ****         }
