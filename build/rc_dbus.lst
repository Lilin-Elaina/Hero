 289:remote/rc_dbus.c ****         s_stage = 0;
 290:remote/rc_dbus.c ****         s_i     = 0.0f;
 291:remote/rc_dbus.c ****         return 0.0f;
 292:remote/rc_dbus.c ****     }
 293:remote/rc_dbus.c **** 
