 187:remote/rc_dbus.c **** 
 188:remote/rc_dbus.c ****     /* ---- 左拨轮：11bit。官方 sbus_to_rc 未对 wheel 掩码；
 189:remote/rc_dbus.c ****      * 此处 &0x07FF 为防御性加固——切掉 b[17] 高 5 位未定义脏位，
 190:remote/rc_dbus.c ****      * 合法帧恒等、异常帧不会把脏位当有效值 ---- */
 191:remote/rc_dbus.c ****     RC_Data.wheel = (uint16_t)((b[16] | ((uint16_t)b[17] << 8)) & 0x07FF);
