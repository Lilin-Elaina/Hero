 945:remote/rc_dbus.c ****       /* 整车回中：当拍四轮积分与目标归零，跳过普通 PI；
 946:remote/rc_dbus.c ****        * 用实测转速做纯 P 反刹（恒逆着运动方向），停稳后撤掉电流。
 947:remote/rc_dbus.c ****        * 跟随/小陀螺模式下自转指令是环算出来的，会频繁穿过 0，
 948:remote/rc_dbus.c ****        * 这时清斜坡等于每穿一次就从零重加速 → 保留斜坡，只给零电流 */
 949:remote/rc_dbus.c ****       if ((follow_on == 0u) && (spin_mode == 0u))
 950:remote/rc_dbus.c ****       {
 951:remote/rc_dbus.c ****           Mecanum_Reset();                /* 手动模式：旧斜坡一并清掉，重新推杆从
 952:remote/rc_dbus.c ****       }
 953:remote/rc_dbus.c ****       for (uint8_t i = 0; i < MECANUM_WHEEL_NUM; i++)
 954:remote/rc_dbus.c ****       {
 955:remote/rc_dbus.c ****           float rpm = (float)dj_wheel[i].rpm;
 956:remote/rc_dbus.c ****           float a;
 957:remote/rc_dbus.c **** 
 958:remote/rc_dbus.c ****           s_wheel_i[i]   = 0.0f;
 959:remote/rc_dbus.c ****           RC_WheelRef[i] = 0.0f;
 960:remote/rc_dbus.c **** 
 961:remote/rc_dbus.c ****           /* 故障轮：反馈已停更，它的 rpm 是最后一帧的旧值，
 962:remote/rc_dbus.c ****            * 拿它算刹车会一直往已停的轮子上灌逆向电流 → 直接给 0 */
 963:remote/rc_dbus.c ****           if ((fault_mask & (uint8_t)(1u << i)) != 0u)
 964:remote/rc_dbus.c ****           {
 965:remote/rc_dbus.c ****               raw[i] = 0;
 966:remote/rc_dbus.c ****               continue;
 967:remote/rc_dbus.c ****           }
 968:remote/rc_dbus.c **** 
