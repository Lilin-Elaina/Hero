 217:remote/rc_dbus.c **** /* 摇杆原始值 → -1.0 ~ +1.0（带死区） */
 218:remote/rc_dbus.c **** float RC_Norm(uint16_t ch)
 219:remote/rc_dbus.c **** {
 220:remote/rc_dbus.c ****     int32_t v = (int32_t)ch - RC_CH_MID;
 221:remote/rc_dbus.c **** 
 222:remote/rc_dbus.c ****     if ((v > -RC_DEADBAND) && (v < RC_DEADBAND))
 223:remote/rc_dbus.c ****         return 0.0f;
 224:remote/rc_dbus.c **** 
 225:remote/rc_dbus.c ****     v = (v > 0) ? (v - RC_DEADBAND) : (v + RC_DEADBAND);
 226:remote/rc_dbus.c **** 
 227:remote/rc_dbus.c ****     float n = (float)v / (float)(RC_CH_MAX - RC_CH_MID);
 228:remote/rc_dbus.c **** 
 229:remote/rc_dbus.c ****     if (n >  1.0f) n =  1.0f;
 230:remote/rc_dbus.c ****     if (n < -1.0f) n = -1.0f;
 231:remote/rc_dbus.c ****     return n;
 232:remote/rc_dbus.c **** }
 233:remote/rc_dbus.c **** /* ==================================================================
 234:remote/rc_dbus.c ****  *  云台 pitch 双环（6020 ID2，1 kHz 调用）
 235:remote/rc_dbus.c ****  *
 236:remote/rc_dbus.c ****  *  三个状态：0=未接管  1=回中  2=正常
 237:remote/rc_dbus.c ****  *  未接管时要求摇杆居中，且参考角永远从"当前位置"起步 → 不会瞬移、
 238:remote/rc_dbus.c ****  *  不会有劣弧、不会一拨使能就跟着摇杆飞。
 239:remote/rc_dbus.c ****  *
 240:remote/rc_dbus.c ****  *  采用位置环 + 速度环的双环控制，位置环输出目标速度，速度环输出电�
 241:remote/rc_dbus.c ****  * ================================================================== */
 242:remote/rc_dbus.c **** 
 243:remote/rc_dbus.c **** 
