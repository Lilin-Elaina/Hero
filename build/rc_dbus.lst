 281:remote/rc_dbus.c **** 
 282:remote/rc_dbus.c **** 
 283:remote/rc_dbus.c ****  if ((HAL_GetTick() - gim_pitch.last_tick) > GM_FEEDBACK_TIMEOUT_MS ||
 284:remote/rc_dbus.c ****         gim_pitch.temp > GM_PITCH_TEMP_LIMIT ||
 285:remote/rc_dbus.c ****         pitch_abs(rpm) > GM_RPM_LIMIT ||
 286:remote/rc_dbus.c ****         cur < (float)GM_PITCH_ANGLE_MIN ||
