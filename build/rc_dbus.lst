  56:remote/rc_dbus.c **** /*清除摇杆数据，在线状态，确定拨杆，开启接收*/
  57:remote/rc_dbus.c **** void RC_Init(void)
  58:remote/rc_dbus.c **** {
  59:remote/rc_dbus.c ****     memset(&RC_Data, 0, sizeof(RC_Data));
  60:remote/rc_dbus.c ****     RC_Data.online = 0;
  61:remote/rc_dbus.c ****     RC_Data.sw_swap = 1u;
  62:remote/rc_dbus.c ****     RC_StartReceive();
  63:remote/rc_dbus.c **** }
