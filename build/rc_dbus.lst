 459:remote/rc_dbus.c ****     {
 460:remote/rc_dbus.c ****         /* 只有真正打开了 D-Cache 才需要做 cache 维护。
 461:remote/rc_dbus.c ****          * 本工程 D-Cache 关闭（SCB->CCR.DC=0），实测此处若无条件调用
 462:remote/rc_dbus.c ****          * SCB_InvalidateDCache_by_Addr() 会在第一帧到达时触发
 463:remote/rc_dbus.c ****          * HardFault（CFSR.IMPRECISERR），导致摇杆永远没反应。 */
 464:remote/rc_dbus.c ****         if ((SCB->CCR & SCB_CCR_DC_Msk) != 0U)
 465:remote/rc_dbus.c ****         {
 466:remote/rc_dbus.c ****             SCB_InvalidateDCache_by_Addr((uint32_t *)dbus_buf, sizeof(dbus_buf));
 467:remote/rc_dbus.c ****         }
 468:remote/rc_dbus.c **** 
 469:remote/rc_dbus.c ****         if (Size >= DBUS_FRAME_LEN)
 470:remote/rc_dbus.c ****         {
 471:remote/rc_dbus.c ****             /* 收到多帧时取最后一帧完整数据 */
 472:remote/rc_dbus.c ****             RC_Decode(&dbus_buf[Size - DBUS_FRAME_LEN]);
 473:remote/rc_dbus.c ****         }
 474:remote/rc_dbus.c **** 
 475:remote/rc_dbus.c ****         RC_StartReceive();   /* 普通模式，需要重新启动 */
 476:remote/rc_dbus.c ****     }
