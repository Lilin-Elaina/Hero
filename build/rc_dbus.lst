 315:remote/rc_dbus.c **** /*在线之后进行判断，若未回中，开始回中*/
 316:remote/rc_dbus.c **** if(s_stage == 1)
 317:remote/rc_dbus.c **** {
 318:remote/rc_dbus.c ****     s_v = 0.0f;
 319:remote/rc_dbus.c ****     /*若一直没符合下面置2的三个条件时触发*/
 320:remote/rc_dbus.c ****     if ((HAL_GetTick() - s_home_since) > GM_PITCH_HOME_TIMEOUT_MS)
 321:remote/rc_dbus.c ****     {
 322:remote/rc_dbus.c ****         /* 回中失败：就地按住，不反复顶、也不锁死，可控 */
 323:remote/rc_dbus.c ****         s_ref        = cur;
 324:remote/rc_dbus.c ****         s_i          = 0.0f;
 325:remote/rc_dbus.c ****         s_homed      = 1;
 326:remote/rc_dbus.c ****         s_stage      = 2;
 327:remote/rc_dbus.c ****         s_home_since = 0;
 328:remote/rc_dbus.c ****         return 0.0f;
 329:remote/rc_dbus.c ****     }
 330:remote/rc_dbus.c ****       s_ref = pitch_step(s_ref, home,GM_PITCH_HOME_RATE * 0.001f );
 331:remote/rc_dbus.c **** 
 332:remote/rc_dbus.c ****       if (pitch_abs(s_ref - home) <= 1.0f &&
 333:remote/rc_dbus.c ****           pitch_abs(rpm)        <  GM_PITCH_CATCH_RPM &&
 334:remote/rc_dbus.c ****           pitch_abs(cur - home) <= 60.0f)
 335:remote/rc_dbus.c ****     {
 336:remote/rc_dbus.c ****        s_ref  = home;
 337:remote/rc_dbus.c ****        s_homed = 1;
 338:remote/rc_dbus.c ****        s_stage = 2;
 339:remote/rc_dbus.c ****        s_home_since = 0;
 340:remote/rc_dbus.c ****     }
 341:remote/rc_dbus.c **** }
 342:remote/rc_dbus.c **** else
 343:remote/rc_dbus.c **** {
 344:remote/rc_dbus.c ****       float v_tgt = s_stick_f * GM_PITCH_MANUAL_RATE;
 345:remote/rc_dbus.c ****       float braking = (v_tgt * s_v < 0.0f)  ||
 346:remote/rc_dbus.c ****       (pitch_abs(v_tgt) < pitch_abs(s_v)) ;
 347:remote/rc_dbus.c **** 
 348:remote/rc_dbus.c ****       float a = (braking) ? GM_PITCH_DECEL : GM_PITCH_ACCEL;
 349:remote/rc_dbus.c ****       float dv = a * 0.001f;
 350:remote/rc_dbus.c **** 
 351:remote/rc_dbus.c ****       if(v_tgt > s_v + dv)      s_v += dv;
 352:remote/rc_dbus.c ****       else if(v_tgt < s_v - dv) s_v -= dv;
 353:remote/rc_dbus.c ****       else                      s_v = v_tgt;
 354:remote/rc_dbus.c **** 
 355:remote/rc_dbus.c **** 
 356:remote/rc_dbus.c ****       s_ref += s_v * 0.001f;
 357:remote/rc_dbus.c **** 
 358:remote/rc_dbus.c **** 
 359:remote/rc_dbus.c **** }
 360:remote/rc_dbus.c **** 
 361:remote/rc_dbus.c **** if(s_ref < lo) s_ref = lo;
 362:remote/rc_dbus.c **** if(s_ref > hi) s_ref = hi;
 363:remote/rc_dbus.c **** 
 364:remote/rc_dbus.c ****     /* 参考速度前馈：参考角这一拍走了多少 → 折算成 rpm，直接叠加到 rpm_
 365:remote/rc_dbus.c ****      * 位置环只有 P，匀速跟踪时必然留下恒定滞后 err = RATE/(136.53*POS_KP)，
 366:remote/rc_dbus.c ****      * 这个非零误差会被速度环积分一路累积到 I_MAX；参考一停、积分却还�
 367:remote/rc_dbus.c ****      * 表现出来就是"冲过头 + 回调很慢"。加了前馈，跟踪误差归零，
 368:remote/rc_dbus.c ****      * 积分只负责扛重力那一点。
 369:remote/rc_dbus.c ****      * 136.53 = 8192/60，即 1 rpm 对应的 counts/s。 */
 370:remote/rc_dbus.c ****     {
 371:remote/rc_dbus.c ****         float v_ff = (s_ref - s_ref_old) * 1000.0f / 136.53f;   /* counts/s → rpm */
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccxzg3PP.s 			page 10


 372:remote/rc_dbus.c **** 
 373:remote/rc_dbus.c ****         err     = s_ref - cur;
 374:remote/rc_dbus.c ****         rpm_des = pitch_clamp(GM_PITCH_POS_KP * err + v_ff,
 375:remote/rc_dbus.c ****                               -GM_PITCH_RPM_MAX, GM_PITCH_RPM_MAX);
 376:remote/rc_dbus.c ****     }
 377:remote/rc_dbus.c **** 
 378:remote/rc_dbus.c **** 
