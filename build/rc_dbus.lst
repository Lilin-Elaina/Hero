  32:remote/rc_dbus.c **** #if defined(__GNUC__)
  33:remote/rc_dbus.c **** static uint8_t dbus_buf[DBUS_FRAME_LEN * 2]
  34:remote/rc_dbus.c ****     __attribute__((section(".dma_buffer"), aligned(32)));
  35:remote/rc_dbus.c **** #else
