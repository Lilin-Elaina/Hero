  60:remote/rc_dbus.c **** {
  61:remote/rc_dbus.c ****     memset(&RC_Data, 0, sizeof(RC_Data));
  62:remote/rc_dbus.c ****     RC_Data.online = 0;
  63:remote/rc_dbus.c ****     RC_Data.sw_swap = 1u;
