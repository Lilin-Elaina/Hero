  23:remote/rc_dbus.c **** /* DMA 接收缓冲：2 帧容量
  24:remote/rc_dbus.c ****  *
  25:remote/rc_dbus.c ****  * ★ 必须放在 DMA 可访问的内存里：STM32H7 的 DTCM(0x20000000) 只有 Cortex-M7
  26:remote/rc_dbus.c ****  *   的 D-bus 能访问，DMA1/DMA2 往 DTCM 写会在第一个字节就报传输错误。
  27:remote/rc_dbus.c ****  *   本工程 .data/.bss 都在 DTCMRAM，所以这里显式指定 .dma_buffer 段，
  28:remote/rc_dbus.c ****  *   该段在 STM32H723xG_flash.ld 里被链接到 RAM_D1(0x24000000)。
  29:remote/rc_dbus.c ****  *   32 字节对齐是为了将来若打开 D-Cache 仍能安全做 cache 维护。 */
  30:remote/rc_dbus.c **** #if defined(__GNUC__)
  31:remote/rc_dbus.c **** static uint8_t dbus_buf[DBUS_FRAME_LEN * 2]
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccLwGY7f.s 			page 2


  32:remote/rc_dbus.c ****     __attribute__((section(".dma_buffer"), aligned(32)));
  33:remote/rc_dbus.c **** #else
  34:remote/rc_dbus.c **** static uint8_t dbus_buf[DBUS_FRAME_LEN * 2];
  35:remote/rc_dbus.c **** #endif
  36:remote/rc_dbus.c **** 
  37:remote/rc_dbus.c **** void RC_StartReceive(void)
  38:remote/rc_dbus.c **** {//启动dbus数据的idle dma接收中断
  39:remote/rc_dbus.c ****     /* 上一帧若因溢出/噪声卡在 ORE，不清掉就再也收不到新数据 */
  40:remote/rc_dbus.c ****     __HAL_UART_CLEAR_OREFLAG(&huart5);
  41:remote/rc_dbus.c **** 
  42:remote/rc_dbus.c ****     /* DMA 普通模式，靠串口总线空闲（IDLE）判定一帧结束 */
  43:remote/rc_dbus.c ****     if (HAL_UARTEx_ReceiveToIdle_DMA(&huart5, dbus_buf, sizeof(dbus_buf)) != HAL_OK)
  44:remote/rc_dbus.c ****     {
  45:remote/rc_dbus.c ****         /* 启动失败（上一次接收还没拆干净）：强制中止后重试一次，
  46:remote/rc_dbus.c ****          * 否则接收链会永久静默，表现为“遥控器完全没反应” */
  47:remote/rc_dbus.c ****         HAL_UART_AbortReceive(&huart5);
  48:remote/rc_dbus.c ****         (void)HAL_UARTEx_ReceiveToIdle_DMA(&huart5, dbus_buf, sizeof(dbus_buf));
  49:remote/rc_dbus.c ****     }
  50:remote/rc_dbus.c **** 
  51:remote/rc_dbus.c ****     /* 关掉半传输中断，避免回调被提前触发一次 */
  52:remote/rc_dbus.c ****     if (huart5.hdmarx != NULL)
  53:remote/rc_dbus.c ****     {
  54:remote/rc_dbus.c ****         __HAL_DMA_DISABLE_IT(huart5.hdmarx, DMA_IT_HT);
  55:remote/rc_dbus.c ****     }
  56:remote/rc_dbus.c **** }
