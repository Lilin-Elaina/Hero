  65:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  66:remote/rc_dbus.c **** /* 18 字节帧完整解析（与大疆官方 sbus_to_rc() 逐位一致）                */
  67:remote/rc_dbus.c **** /*   byte0~5  : 4 路摇杆×11bit + 2 路拨杆×2bit                         */
  68:remote/rc_dbus.c **** /*   byte6~13 : 鼠标 x/y/z + 左右键                                    */
  69:remote/rc_dbus.c **** /*   byte14~15: 键盘按键位图                                           */
  70:remote/rc_dbus.c **** /*   byte16~17: 左拨轮(11bit)                                          */
  71:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  72:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  73:remote/rc_dbus.c **** /* 拨杆位域自动判定（确定性，不需人工判读）                              */
  74:remote/rc_dbus.c **** /*   实测法：把 DT7 左拨杆停在非中位、右拨杆保持中位，持续 1 秒。        
  75:remote/rc_dbus.c **** /*   这一秒内“稳定处于非中位”的那个位域 = 物理左拨杆 → 自动置 sw_swap
  76:remote/rc_dbus.c **** /*   只在 sw_auto_window_ms 内开放，判定成功即永久锁定。                 */
  77:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  78:remote/rc_dbus.c **** #define RC_SW_AUTO_HOLD_MS      1000    /* 条件需连续保持多少毫秒 */
  79:remote/rc_dbus.c **** #define RC_SW_AUTO_WINDOW_MS    3000    /* 上电后多久内允许自动判定 */
  80:remote/rc_dbus.c **** 
  81:remote/rc_dbus.c **** #define RC_OBS_NONE      0              /* 两个位域都在中位 */
  82:remote/rc_dbus.c **** #define RC_OBS_LO_MOVED  1              /* 只有 bit4~5 离开中位 */
  83:remote/rc_dbus.c **** #define RC_OBS_HI_MOVED  2              /* 只有 bit6~7 离开中位 */
  84:remote/rc_dbus.c **** #define RC_OBS_INVALID   3              /* 两个都离开中位 → 本段不计 */
  85:remote/rc_dbus.c **** 
  86:remote/rc_dbus.c **** void RC_SwitchAutoName(void)
  87:remote/rc_dbus.c **** {
  88:remote/rc_dbus.c ****     uint32_t now = HAL_GetTick();
ARM GAS  C:\Users\elaina\AppData\Local\Temp\ccEC73IT.s 			page 3


  89:remote/rc_dbus.c **** 
  90:remote/rc_dbus.c ****     if (RC_Data.sw_auto_done)
  91:remote/rc_dbus.c ****     {
  92:remote/rc_dbus.c ****         return;                                     /* 已锁定，永不改写 */
  93:remote/rc_dbus.c ****     }
  94:remote/rc_dbus.c **** 
  95:remote/rc_dbus.c ****     /* 第一帧到达时开判定窗口（此前的上电时间不计入窗口） */
  96:remote/rc_dbus.c ****     if (RC_Data.sw_first_frame_ms == 0)
  97:remote/rc_dbus.c ****     {
  98:remote/rc_dbus.c ****         RC_Data.sw_first_frame_ms = now ? now : 1u;
  99:remote/rc_dbus.c ****         RC_Data.sw_obs_start_ms   = 0;
 100:remote/rc_dbus.c ****         RC_Data.sw_obs_last       = RC_OBS_NONE;
 101:remote/rc_dbus.c ****         RC_Data.sw_obs_hold       = 0;
 102:remote/rc_dbus.c ****     }
 103:remote/rc_dbus.c **** 
 104:remote/rc_dbus.c ****     if ((now - RC_Data.sw_first_frame_ms) > RC_SW_AUTO_WINDOW_MS)
 105:remote/rc_dbus.c ****     {
 106:remote/rc_dbus.c ****         return;                                     /* 窗口已过 → 保持默认，永久放弃
 107:remote/rc_dbus.c ****     }
 108:remote/rc_dbus.c **** 
 109:remote/rc_dbus.c ****     /* 本帧观测：必须“恰好一个位域非中位”才有信息量 */
 110:remote/rc_dbus.c ****     uint8_t lo_mid = (RC_Data.sw_lo2 == RC_SW_MID) ? 1u : 0u;
 111:remote/rc_dbus.c ****     uint8_t hi_mid = (RC_Data.sw_hi2 == RC_SW_MID) ? 1u : 0u;
 112:remote/rc_dbus.c ****     uint8_t obs;
 113:remote/rc_dbus.c **** 
 114:remote/rc_dbus.c ****     if (lo_mid && hi_mid)        obs = RC_OBS_NONE;
 115:remote/rc_dbus.c ****     else if (!lo_mid && hi_mid)  obs = RC_OBS_LO_MOVED;
 116:remote/rc_dbus.c ****     else if (lo_mid && !hi_mid)  obs = RC_OBS_HI_MOVED;
 117:remote/rc_dbus.c ****     else                         obs = RC_OBS_INVALID;
 118:remote/rc_dbus.c **** 
 119:remote/rc_dbus.c ****     if ((obs != RC_Data.sw_obs_last) || (obs == RC_OBS_NONE) || (obs == RC_OBS_INVALID))
 120:remote/rc_dbus.c ****     {
 121:remote/rc_dbus.c ****         /* 观测状态变了（或本段无信息量）→ 重新开始计时 */
 122:remote/rc_dbus.c ****         RC_Data.sw_obs_last     = obs;
 123:remote/rc_dbus.c ****         RC_Data.sw_obs_hold     = 0;
 124:remote/rc_dbus.c ****         RC_Data.sw_obs_start_ms = (obs == RC_OBS_LO_MOVED || obs == RC_OBS_HI_MOVED) ? now : 0u;
 125:remote/rc_dbus.c ****         return;
 126:remote/rc_dbus.c ****     }
 127:remote/rc_dbus.c **** 
 128:remote/rc_dbus.c ****     if (RC_Data.sw_obs_hold < 250u)
 129:remote/rc_dbus.c ****     {
 130:remote/rc_dbus.c ****         RC_Data.sw_obs_hold++;
 131:remote/rc_dbus.c ****     }
 132:remote/rc_dbus.c **** 
 133:remote/rc_dbus.c ****     if (((RC_Data.sw_obs_start_ms != 0u) ? (now - RC_Data.sw_obs_start_ms)
 134:remote/rc_dbus.c ****                                         : 0u) >= RC_SW_AUTO_HOLD_MS)
 135:remote/rc_dbus.c ****     {
 136:remote/rc_dbus.c ****         /* 连续 1 秒只有一方离开中位 → 判定完成并永久锁定 */
 137:remote/rc_dbus.c ****         RC_Data.sw_auto_result = (obs == RC_OBS_HI_MOVED) ? 1u : 0u;
 138:remote/rc_dbus.c ****         RC_Data.sw_swap        = RC_Data.sw_auto_result;
 139:remote/rc_dbus.c ****         RC_Data.sw_auto_done   = 1u;
 140:remote/rc_dbus.c ****     }
 141:remote/rc_dbus.c **** }
