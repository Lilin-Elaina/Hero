 201:Drivers/CMSIS/Include/cachel1_armv7.h ****       /*
 202:Drivers/CMSIS/Include/cachel1_armv7.h ****        * For the endless loop issue with no optimization builds.
 203:Drivers/CMSIS/Include/cachel1_armv7.h ****        * More details, see https://github.com/ARM-software/CMSIS_5/issues/620
 204:Drivers/CMSIS/Include/cachel1_armv7.h ****        *
 205:Drivers/CMSIS/Include/cachel1_armv7.h ****        * The issue only happens when local variables are in stack. If
 206:Drivers/CMSIS/Include/cachel1_armv7.h ****        * local variables are saved in general purpose register, then the function
 207:Drivers/CMSIS/Include/cachel1_armv7.h ****        * is OK.
 208:Drivers/CMSIS/Include/cachel1_armv7.h ****        *
 209:Drivers/CMSIS/Include/cachel1_armv7.h ****        * When local variables are in stack, after disabling the cache, flush the
 210:Drivers/CMSIS/Include/cachel1_armv7.h ****        * local variables cache line for data consistency.
 211:Drivers/CMSIS/Include/cachel1_armv7.h ****        */
 212:Drivers/CMSIS/Include/cachel1_armv7.h ****       /* Clean and invalidate the local variable cache. */
 213:Drivers/CMSIS/Include/cachel1_armv7.h ****     #if defined(__ICCARM__)
 214:Drivers/CMSIS/Include/cachel1_armv7.h ****     /* As we can't align the stack to the cache line size, invalidate each of the variables */
 215:Drivers/CMSIS/Include/cachel1_armv7.h ****       SCB->DCCIMVAC = (uint32_t)&locals.sets;
 216:Drivers/CMSIS/Include/cachel1_armv7.h ****       SCB->DCCIMVAC = (uint32_t)&locals.ways;
 217:Drivers/CMSIS/Include/cachel1_armv7.h ****       SCB->DCCIMVAC = (uint32_t)&locals.ccsidr;
 218:Drivers/CMSIS/Include/cachel1_armv7.h ****     #else
 219:Drivers/CMSIS/Include/cachel1_armv7.h ****       SCB->DCCIMVAC = (uint32_t)&locals;
 220:Drivers/CMSIS/Include/cachel1_armv7.h ****     #endif
 221:Drivers/CMSIS/Include/cachel1_armv7.h ****       __DSB();
 222:Drivers/CMSIS/Include/cachel1_armv7.h ****       __ISB();
 223:Drivers/CMSIS/Include/cachel1_armv7.h ****     #endif
 224:Drivers/CMSIS/Include/cachel1_armv7.h **** 
 225:Drivers/CMSIS/Include/cachel1_armv7.h ****     locals.ccsidr = SCB->CCSIDR;
 226:Drivers/CMSIS/Include/cachel1_armv7.h ****                                             /* clean & invalidate D-Cache */
 227:Drivers/CMSIS/Include/cachel1_armv7.h ****     locals.sets = (uint32_t)(CCSIDR_SETS(locals.ccsidr));
 228:Drivers/CMSIS/Include/cachel1_armv7.h ****     do {
 229:Drivers/CMSIS/Include/cachel1_armv7.h ****       locals.ways = (uint32_t)(CCSIDR_WAYS(locals.ccsidr));
 230:Drivers/CMSIS/Include/cachel1_armv7.h ****       do {
 231:Drivers/CMSIS/Include/cachel1_armv7.h ****         SCB->DCCISW = (((locals.sets << SCB_DCCISW_SET_Pos) & SCB_DCCISW_SET_Msk) |
 232:Drivers/CMSIS/Include/cachel1_armv7.h ****                        ((locals.ways << SCB_DCCISW_WAY_Pos) & SCB_DCCISW_WAY_Msk)  );
 233:Drivers/CMSIS/Include/cachel1_armv7.h ****         #if defined ( __CC_ARM )
 234:Drivers/CMSIS/Include/cachel1_armv7.h ****           __schedule_barrier();
 235:Drivers/CMSIS/Include/cachel1_armv7.h ****         #endif
 236:Drivers/CMSIS/Include/cachel1_armv7.h ****       } while (locals.ways-- != 0U);
 237:Drivers/CMSIS/Include/cachel1_armv7.h ****     } while(locals.sets-- != 0U);
 238:Drivers/CMSIS/Include/cachel1_armv7.h **** 
 239:Drivers/CMSIS/Include/cachel1_armv7.h ****     __DSB();
 240:Drivers/CMSIS/Include/cachel1_armv7.h ****     __ISB();
 241:Drivers/CMSIS/Include/cachel1_armv7.h ****   #endif
 242:Drivers/CMSIS/Include/cachel1_armv7.h **** }
