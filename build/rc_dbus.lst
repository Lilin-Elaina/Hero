 385:remote/rc_dbus.c **** s_i = pitch_clamp(s_i, -GM_PITCH_I_MAX,GM_PITCH_I_MAX);
 386:remote/rc_dbus.c **** }
 387:remote/rc_dbus.c **** 
 388:remote/rc_dbus.c **** volt = pitch_clamp(GM_PITCH_SPD_KP* err + s_i + GM_PITCH_GRAV_FF, -GM_PITCH_VOLT_MAX,GM_PITCH_VOLT_
 389:remote/rc_dbus.c **** 
 390:remote/rc_dbus.c ****     /* 软墙：距离边界 soft 以内，把"往外推"的力按比例衰减到 0，
 391:remote/rc_dbus.c ****        避免"出力/不出力"每毫秒硬切换导致的高频起振 */
 392:remote/rc_dbus.c ****     const float soft = 120.0f;
 393:remote/rc_dbus.c **** 
 394:remote/rc_dbus.c ****     if (cur <= lo)
 395:remote/rc_dbus.c ****     {
 396:remote/rc_dbus.c ****         /* 已经在墙外：只允许往回走的力 */
 397:remote/rc_dbus.c ****         if (volt < 0.0f) volt = 0.0f;
 398:remote/rc_dbus.c ****     }
 399:remote/rc_dbus.c ****     else if (cur >= hi)
 400:remote/rc_dbus.c ****     {
 401:remote/rc_dbus.c ****         if (volt > 0.0f) volt = 0.0f;
 402:remote/rc_dbus.c ****     }
 403:remote/rc_dbus.c ****     else if (cur < lo + soft && volt < 0.0f)
 404:remote/rc_dbus.c ****     {
 405:remote/rc_dbus.c ****         /* 靠近下限：往下推的力按比例减小，贴墙时正好为 0 */
 406:remote/rc_dbus.c ****         volt *= (cur - lo) / soft;
 407:remote/rc_dbus.c ****     }
 408:remote/rc_dbus.c ****     else if (cur > hi - soft && volt > 0.0f)
 409:remote/rc_dbus.c ****     {
 410:remote/rc_dbus.c ****         /* 靠近上限：往上推的力按比例减小 */
 411:remote/rc_dbus.c ****         volt *= (hi - cur) / soft;
 412:remote/rc_dbus.c ****     }
 413:remote/rc_dbus.c **** 
 414:remote/rc_dbus.c **** return GM_PITCH_SIGN * volt;
 415:remote/rc_dbus.c **** 
 416:remote/rc_dbus.c **** }
