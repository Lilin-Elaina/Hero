 976:remote/rc_dbus.c ****           }
 977:remote/rc_dbus.c **** 
 978:remote/rc_dbus.c ****           raw[i] = (int16_t)(a / 20.0f * 16384.0f);
 979:remote/rc_dbus.c ****       }
