  35:remote/rc_dbus.c **** #endif
  36:remote/rc_dbus.c **** 
  37:remote/rc_dbus.c **** void RC_StartReceive(void)
  38:remote/rc_dbus.c **** {//启动dbus数据的idle dma接收中断
  39:remote/rc_dbus.c ****     /* 上一帧若因溢出/噪声卡在 ORE，不清掉就再也收不到新数据 */
  40:remote/rc_dbus.c ****     __HAL_UART_CLEAR_OREFLAG(&huart5);
  41:remote/rc_dbus.c **** 
  42:remote/rc_dbus.c ****     /* DMA 普通模式，靠串口总线空闲（IDLE）判定一帧结束 */
  43:remote/rc_dbus.c ****     if (HAL_UARTEx_ReceiveToIdle_DMA(&huart5, dbus_buf, sizeof(dbus_buf)) != HAL_OK)
  44:remote/rc_dbus.c ****     {
  45:remote/rc_dbus.c ****         /* 启动失败（上一次接收还没拆干净）：强制中止后重试一次，
  46:remote/rc_dbus.c ****          * 否则接收链会永久静默，表现为“遥控器完全没反应” */
  47:remote/rc_dbus.c ****         HAL_UART_AbortReceive(&huart5);
  48:remote/rc_dbus.c ****         (void)HAL_UARTEx_ReceiveToIdle_DMA(&huart5, dbus_buf, sizeof(dbus_buf));
  49:remote/rc_dbus.c ****     }
  50:remote/rc_dbus.c **** 
  51:remote/rc_dbus.c ****     /* 关掉半传输中断，避免回调被提前触发一次 */
  52:remote/rc_dbus.c ****     if (huart5.hdmarx != NULL)
  53:remote/rc_dbus.c ****     {
  54:remote/rc_dbus.c ****         __HAL_DMA_DISABLE_IT(huart5.hdmarx, DMA_IT_HT);
  55:remote/rc_dbus.c ****     }
  56:remote/rc_dbus.c **** }
