 969:remote/rc_dbus.c ****       /* 整车回中：当拍四轮积分与目标归零，跳过普通 PI；
 970:remote/rc_dbus.c ****        * 用实测转速做纯 P 反刹（恒逆着运动方向），停稳后撤掉电流。
 971:remote/rc_dbus.c ****        * 跟随/小陀螺模式下自转指令是环算出来的，会频繁穿过 0，
 972:remote/rc_dbus.c ****        * 这时清斜坡等于每穿一次就从零重加速 → 保留斜坡，只给零电流 */
 973:remote/rc_dbus.c ****       if ((follow_on == 0u) && (spin_mode == 0u))
 974:remote/rc_dbus.c ****       {
 975:remote/rc_dbus.c ****           Mecanum_Reset();                /* 手动模式：旧斜坡一并清掉，重新推杆从
 976:remote/rc_dbus.c ****       }
 977:remote/rc_dbus.c ****       for (uint8_t i = 0; i < MECANUM_WHEEL_NUM; i++)
 978:remote/rc_dbus.c ****       {
 979:remote/rc_dbus.c ****           float rpm = (float)dj_wheel[i].rpm;
 980:remote/rc_dbus.c ****           float a;
 981:remote/rc_dbus.c **** 
 982:remote/rc_dbus.c ****           s_wheel_i[i]   = 0.0f;
 983:remote/rc_dbus.c ****           RC_WheelRef[i] = 0.0f;
 984:remote/rc_dbus.c **** 
 985:remote/rc_dbus.c ****           /* 故障轮：反馈已停更，它的 rpm 是最后一帧的旧值，
