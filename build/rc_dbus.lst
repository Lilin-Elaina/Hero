 202:remote/rc_dbus.c **** /* 摇杆原始值 → -1.0 ~ +1.0（带死区） */
ARM GAS  C:\Users\elaina\AppData\Local\Temp\ccEC73IT.s 			page 5


 203:remote/rc_dbus.c **** float RC_Norm(uint16_t ch)
 204:remote/rc_dbus.c **** {
 205:remote/rc_dbus.c ****     int32_t v = (int32_t)ch - RC_CH_MID;
 206:remote/rc_dbus.c **** 
 207:remote/rc_dbus.c ****     if ((v > -RC_DEADBAND) && (v < RC_DEADBAND))
 208:remote/rc_dbus.c ****         return 0.0f;
 209:remote/rc_dbus.c **** 
 210:remote/rc_dbus.c ****     v = (v > 0) ? (v - RC_DEADBAND) : (v + RC_DEADBAND);
 211:remote/rc_dbus.c **** 
 212:remote/rc_dbus.c ****     float n = (float)v / (float)(RC_CH_MAX - RC_CH_MID);
 213:remote/rc_dbus.c **** 
 214:remote/rc_dbus.c ****     if (n >  1.0f) n =  1.0f;
 215:remote/rc_dbus.c ****     if (n < -1.0f) n = -1.0f;
 216:remote/rc_dbus.c ****     return n;
 217:remote/rc_dbus.c **** }
 218:remote/rc_dbus.c **** /* ==================================================================
 219:remote/rc_dbus.c ****  *  云台 pitch 双环（6020 ID2，1 kHz 调用）
 220:remote/rc_dbus.c ****  *
 221:remote/rc_dbus.c ****  *  三个状态：0=未接管  1=回中  2=正常
 222:remote/rc_dbus.c ****  *  未接管时要求摇杆居中，且参考角永远从"当前位置"起步 → 不会瞬移、
 223:remote/rc_dbus.c ****  *  不会有劣弧、不会一拨使能就跟着摇杆飞。
 224:remote/rc_dbus.c ****  *
 225:remote/rc_dbus.c ****  *  为什么积分只放速度环：两个积分串联相位滞后 180°，必然振荡。
 226:remote/rc_dbus.c ****  * ================================================================== */
 227:remote/rc_dbus.c **** 
