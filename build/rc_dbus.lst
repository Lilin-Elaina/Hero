 590:remote/rc_dbus.c ****     /* ②.5 到位清零积分
 591:remote/rc_dbus.c ****      * 现象：快转到位、定住 1~2 s 后又小幅度回摆一下。
 592:remote/rc_dbus.c ****      * 原因：到位瞬间速度环还留着正向积分，位置环慢慢把角度拽回来，
 593:remote/rc_dbus.c ****      *       积分一点点卸，卸完才不动 —— 那一下回摆就是它在卸。
 594:remote/rc_dbus.c ****      * 做法：位置误差和转速都小到"已经到位"时，直接把积分清掉。 */
 595:remote/rc_dbus.c ****     if ((err < GM_YAW_ARRIVE_CNT) && (err > -GM_YAW_ARRIVE_CNT) &&
 596:remote/rc_dbus.c ****         (gim6020.rpm < GM_YAW_ARRIVE_RPM) && (gim6020.rpm > -GM_YAW_ARRIVE_RPM)) {
 597:remote/rc_dbus.c ****         s_yaw_i = 0.0f;
 598:remote/rc_dbus.c ****     }
 599:remote/rc_dbus.c **** 
 600:remote/rc_dbus.c ****     {
 601:remote/rc_dbus.c ****         /* D 项单独限幅：不封顶的话 250 rpm × 0.6 = 150 rpm，占满 RPM_MAX 的 60%，
 602:remote/rc_dbus.c ****          * 减速段 D 项一直满舵，冲过目标再被拉回 —— 就是"来回拟合"的根
 603:remote/rc_dbus.c ****         float d_term = -GM_YAW_POS_DIR * GM_YAW_ANG_KD * (float)gim6020.rpm;
 604:remote/rc_dbus.c **** 
 605:remote/rc_dbus.c ****         if (d_term >  GM_YAW_ANG_D_MAX) d_term =  GM_YAW_ANG_D_MAX;
 606:remote/rc_dbus.c ****         if (d_term < -GM_YAW_ANG_D_MAX) d_term = -GM_YAW_ANG_D_MAX;
 607:remote/rc_dbus.c **** 
 608:remote/rc_dbus.c ****         rpm_d = GM_YAW_POS_DIR * GM_YAW_ANG_KP * err
 609:remote/rc_dbus.c ****               + d_ref * 1000.0f / 136.53f
 610:remote/rc_dbus.c ****               + hold_rate * (1.0f / 6.0f)   /* deg/s → rpm：稳向的速度前馈 */
 611:remote/rc_dbus.c ****               + d_term;
 612:remote/rc_dbus.c ****     }
 613:remote/rc_dbus.c ****     if (rpm_d >  GM_YAW_RPM_MAX) rpm_d =  GM_YAW_RPM_MAX;
 614:remote/rc_dbus.c ****     if (rpm_d < -GM_YAW_RPM_MAX) rpm_d = -GM_YAW_RPM_MAX;
 615:remote/rc_dbus.c **** 
 616:remote/rc_dbus.c ****     /* ③ 速度 PI（条件积分 + 限幅） */
 617:remote/rc_dbus.c ****     err_v = rpm_d - (float)gim6020.rpm;
 618:remote/rc_dbus.c ****     volt  = GM_YAW_SPD_KP * err_v + s_yaw_i;
 619:remote/rc_dbus.c **** 
 620:remote/rc_dbus.c ****     if ((volt < GM_YAW_VOLT_MAX) && (volt > -GM_YAW_VOLT_MAX)) {
 621:remote/rc_dbus.c ****         s_yaw_i += GM_YAW_SPD_KI * err_v * 0.001f;
 622:remote/rc_dbus.c ****         if (s_yaw_i >  GM_YAW_I_MAX) s_yaw_i =  GM_YAW_I_MAX;
 623:remote/rc_dbus.c ****         if (s_yaw_i < -GM_YAW_I_MAX) s_yaw_i = -GM_YAW_I_MAX;
 624:remote/rc_dbus.c ****     }
 625:remote/rc_dbus.c ****     volt = GM_YAW_SPD_KP * err_v + s_yaw_i;
 626:remote/rc_dbus.c **** 
 627:remote/rc_dbus.c ****     if (volt >  GM_YAW_VOLT_MAX) volt =  GM_YAW_VOLT_MAX;
 628:remote/rc_dbus.c ****     if (volt < -GM_YAW_VOLT_MAX) volt = -GM_YAW_VOLT_MAX;
 629:remote/rc_dbus.c **** 
 630:remote/rc_dbus.c ****     /* 调试镜像 */
 631:remote/rc_dbus.c ****     RC_YawRef    = s_yaw_ref;
 632:remote/rc_dbus.c ****     RC_YawErr    = err;
 633:remote/rc_dbus.c ****     RC_YawRpmDes = rpm_d;
 634:remote/rc_dbus.c ****     RC_YawVolt   = volt;
 635:remote/rc_dbus.c ****     RC_YawI      = s_yaw_i;
 636:remote/rc_dbus.c **** 
 637:remote/rc_dbus.c ****     return volt;
 638:remote/rc_dbus.c **** }
