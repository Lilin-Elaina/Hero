 677:remote/rc_dbus.c **** 
 678:remote/rc_dbus.c ****     /* ③ 目标世界角速度 = 摇杆那份 + 把误差拉回 */
 679:remote/rc_dbus.c ****     w_cmd = aim + SPIN_YAW_POS_KP * e;
 680:remote/rc_dbus.c **** 
 681:remote/rc_dbus.c ****     if (w_cmd >  SPIN_YAW_RATE_MAX) w_cmd =  SPIN_YAW_RATE_MAX;
 682:remote/rc_dbus.c ****     if (w_cmd < -SPIN_YAW_RATE_MAX) w_cmd = -SPIN_YAW_RATE_MAX;
 683:remote/rc_dbus.c **** 
 684:remote/rc_dbus.c ****     /* ④ 实测底盘角速度 = 枪口世界角速度 − 关节角速度（1 rpm = 6 °/s） */
 685:remote/rc_dbus.c ****     w_chassis = (float)INS_WorldYawRate - 6.0f * (float)gim6020.rpm;
 686:remote/rc_dbus.c **** 
 687:remote/rc_dbus.c ****     /* ④.5 失控兜底：世界角速度长时间超 ±800 °/s，说明这条环在正反馈
 688:remote/rc_dbus.c ****      * （符号/方向接反），收油并把目标拉回当前航向，绝不让它一直疯转�
 689:remote/rc_dbus.c ****      * 正常工况下 ω_world 被钉在 0 附近，不可能触发。 */
 690:remote/rc_dbus.c ****     if ((INS_WorldYawRate > 800.0f) || (INS_WorldYawRate < -800.0f)) {
 691:remote/rc_dbus.c ****         if (s_spin_bad < 300u) s_spin_bad++;
 692:remote/rc_dbus.c ****         if (s_spin_bad >= 300u) {
 693:remote/rc_dbus.c ****             s_spin_ref = (float)INS_WorldYaw;
 694:remote/rc_dbus.c ****             s_spin_i   = 0.0f;
 695:remote/rc_dbus.c ****             s_spin_bad = 0u;
 696:remote/rc_dbus.c ****             RC_SpinWch = w_chassis;
 697:remote/rc_dbus.c ****             RC_YawVolt = 0.0f;
 698:remote/rc_dbus.c ****             return 0.0f;
 699:remote/rc_dbus.c ****         }
 700:remote/rc_dbus.c ****     } else {
 701:remote/rc_dbus.c ****         s_spin_bad = 0u;
 702:remote/rc_dbus.c ****     }
 703:remote/rc_dbus.c **** 
 704:remote/rc_dbus.c ****     /* ⑤ 关节该转多少：ω_joint = w_cmd − ω_chassis，换成 rpm */
 705:remote/rc_dbus.c ****     rpm_d = (w_cmd - w_chassis) * (1.0f / 6.0f);
 706:remote/rc_dbus.c **** 
 707:remote/rc_dbus.c ****     if (rpm_d >  SPIN_YAW_RPM_MAX) rpm_d =  SPIN_YAW_RPM_MAX;
 708:remote/rc_dbus.c ****     if (rpm_d < -SPIN_YAW_RPM_MAX) rpm_d = -SPIN_YAW_RPM_MAX;
 709:remote/rc_dbus.c **** 
 710:remote/rc_dbus.c ****     /* ⑥ 关节速度环：反电势前馈 + P + 慢积分。
 711:remote/rc_dbus.c ****      * 前馈是这套的关键：6020 想稳在 33 rpm，必须有 ≈3133 单位的反电势电�
 712:remote/rc_dbus.c ****      * 只靠 P 拿，就要 3133/300 ≈ 10 rpm 的稳态速度误差，
 713:remote/rc_dbus.c ****      * 折算到航向上就是几十度——这就是"一段时间后被带偏"的来历。 */
 714:remote/rc_dbus.c ****     err_v = rpm_d - (float)gim6020.rpm;
 715:remote/rc_dbus.c ****     volt  = SPIN_YAW_KV * rpm_d + SPIN_YAW_SPD_KP * err_v + s_spin_i;
 716:remote/rc_dbus.c **** 
 717:remote/rc_dbus.c ****     if ((volt < GM_YAW_VOLT_MAX) && (volt > -GM_YAW_VOLT_MAX)) {
 718:remote/rc_dbus.c ****         s_spin_i += SPIN_YAW_KI * err_v * 0.001f;
 719:remote/rc_dbus.c ****         if (s_spin_i >  SPIN_YAW_I_MAX) s_spin_i =  SPIN_YAW_I_MAX;
 720:remote/rc_dbus.c ****         if (s_spin_i < -SPIN_YAW_I_MAX) s_spin_i = -SPIN_YAW_I_MAX;
 721:remote/rc_dbus.c ****     }
 722:remote/rc_dbus.c ****     volt = SPIN_YAW_KV * rpm_d + SPIN_YAW_SPD_KP * err_v + s_spin_i;
 723:remote/rc_dbus.c **** 
 724:remote/rc_dbus.c ****     if (volt >  GM_YAW_VOLT_MAX) volt =  GM_YAW_VOLT_MAX;
 725:remote/rc_dbus.c ****     if (volt < -GM_YAW_VOLT_MAX) volt = -GM_YAW_VOLT_MAX;
 726:remote/rc_dbus.c **** 
 727:remote/rc_dbus.c ****     /* 调试镜像 */
 728:remote/rc_dbus.c ****     RC_SpinYaw   = (float)INS_WorldYaw;
 729:remote/rc_dbus.c ****     RC_SpinWch   = w_chassis;
 730:remote/rc_dbus.c ****     RC_SpinErr   = e;
 731:remote/rc_dbus.c ****     RC_YawRef    = s_spin_ref;      /* 注意：小陀螺下这里是"世界目标角 deg"，不是
 732:remote/rc_dbus.c ****     RC_YawErr    = e;
 733:remote/rc_dbus.c ****     RC_YawRpmDes = rpm_d;
