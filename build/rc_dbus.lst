 204:remote/rc_dbus.c **** /* 摇杆原始值 → -1.0 ~ +1.0（带死区） */
 205:remote/rc_dbus.c **** float RC_Norm(uint16_t ch)
 206:remote/rc_dbus.c **** {
 207:remote/rc_dbus.c ****     int32_t v = (int32_t)ch - RC_CH_MID;
 208:remote/rc_dbus.c **** 
 209:remote/rc_dbus.c ****     if ((v > -RC_DEADBAND) && (v < RC_DEADBAND))
 210:remote/rc_dbus.c ****         return 0.0f;
 211:remote/rc_dbus.c **** 
 212:remote/rc_dbus.c ****     v = (v > 0) ? (v - RC_DEADBAND) : (v + RC_DEADBAND);
 213:remote/rc_dbus.c **** 
 214:remote/rc_dbus.c ****     float n = (float)v / (float)(RC_CH_MAX - RC_CH_MID);
 215:remote/rc_dbus.c **** 
 216:remote/rc_dbus.c ****     if (n >  1.0f) n =  1.0f;
 217:remote/rc_dbus.c ****     if (n < -1.0f) n = -1.0f;
 218:remote/rc_dbus.c ****     return n;
 219:remote/rc_dbus.c **** }
