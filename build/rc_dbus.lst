 677:remote/rc_dbus.c ****     /* ③ 目标世界角速度 = 摇杆那份 + 把误差拉回 */
 678:remote/rc_dbus.c ****     w_cmd = aim + SPIN_YAW_POS_KP * e;
 679:remote/rc_dbus.c **** 
 680:remote/rc_dbus.c ****     /* ④ 实测底盘角速度 = 枪口世界角速度 − 关节角速度（1 rpm = 6 °/s） */
 681:remote/rc_dbus.c ****     w_chassis = (float)INS_WorldYawRate - 6.0f * (float)gim6020.rpm;
 682:remote/rc_dbus.c **** 
 683:remote/rc_dbus.c ****     /* ⑤ 关节该转多少：ω_joint = w_cmd − ω_chassis，换成 rpm */
 684:remote/rc_dbus.c ****     rpm_d = (w_cmd - w_chassis) * (1.0f / 6.0f);
 685:remote/rc_dbus.c **** 
 686:remote/rc_dbus.c ****     if (rpm_d >  SPIN_YAW_RPM_MAX) rpm_d =  SPIN_YAW_RPM_MAX;
 687:remote/rc_dbus.c ****     if (rpm_d < -SPIN_YAW_RPM_MAX) rpm_d = -SPIN_YAW_RPM_MAX;
 688:remote/rc_dbus.c **** 
 689:remote/rc_dbus.c ****     /* ⑥ 复用已验证的速度环（同一套 GM_YAW_SPD_KP / 限幅），积分只补零偏 *
 690:remote/rc_dbus.c ****     err_v = rpm_d - (float)gim6020.rpm;
 691:remote/rc_dbus.c ****     volt  = GM_YAW_SPD_KP * err_v + s_spin_i;
 692:remote/rc_dbus.c **** 
 693:remote/rc_dbus.c ****     if ((volt < GM_YAW_VOLT_MAX) && (volt > -GM_YAW_VOLT_MAX)) {
 694:remote/rc_dbus.c ****         s_spin_i += SPIN_YAW_KI * err_v * 0.001f;
 695:remote/rc_dbus.c ****         if (s_spin_i >  SPIN_YAW_I_MAX) s_spin_i =  SPIN_YAW_I_MAX;
 696:remote/rc_dbus.c ****         if (s_spin_i < -SPIN_YAW_I_MAX) s_spin_i = -SPIN_YAW_I_MAX;
 697:remote/rc_dbus.c ****     }
 698:remote/rc_dbus.c ****     volt = GM_YAW_SPD_KP * err_v + s_spin_i;
 699:remote/rc_dbus.c **** 
 700:remote/rc_dbus.c ****     if (volt >  GM_YAW_VOLT_MAX) volt =  GM_YAW_VOLT_MAX;
 701:remote/rc_dbus.c ****     if (volt < -GM_YAW_VOLT_MAX) volt = -GM_YAW_VOLT_MAX;
 702:remote/rc_dbus.c **** 
 703:remote/rc_dbus.c ****     /* 调试镜像 */
 704:remote/rc_dbus.c ****     RC_SpinYaw   = (float)INS_WorldYaw;
 705:remote/rc_dbus.c ****     RC_SpinWch   = w_chassis;
 706:remote/rc_dbus.c ****     RC_SpinErr   = e;
 707:remote/rc_dbus.c ****     RC_YawRef    = s_spin_ref;      /* 注意：小陀螺下这里是"世界目标角 deg"，不是
 708:remote/rc_dbus.c ****     RC_YawErr    = e;
 709:remote/rc_dbus.c ****     RC_YawRpmDes = rpm_d;
 710:remote/rc_dbus.c ****     RC_YawVolt   = volt;
 711:remote/rc_dbus.c ****     RC_YawI      = s_spin_i;
 712:remote/rc_dbus.c **** 
 713:remote/rc_dbus.c ****     return volt;
 714:remote/rc_dbus.c **** }
