  69:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  70:remote/rc_dbus.c **** /* 18 字节帧完整解析（与大疆官方 sbus_to_rc() 逐位一致）                */
  71:remote/rc_dbus.c **** /*   byte0~5  : 4 路摇杆×11bit + 2 路拨杆×2bit                         */
  72:remote/rc_dbus.c **** /*   byte6~13 : 鼠标 x/y/z + 左右键                                    */
  73:remote/rc_dbus.c **** /*   byte14~15: 键盘按键位图                                           */
  74:remote/rc_dbus.c **** /*   byte16~17: 左拨轮(11bit)                                          */
  75:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  76:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  77:remote/rc_dbus.c **** /* 拨杆位域自动判定（确定性，不需人工判读）                              */
  78:remote/rc_dbus.c **** /*   实测法：把 DT7 左拨杆停在非中位、右拨杆保持中位，持续 1 秒。        
  79:remote/rc_dbus.c **** /*   这一秒内“稳定处于非中位”的那个位域 = 物理左拨杆 → 自动置 sw_swap
  80:remote/rc_dbus.c **** /*   只在 sw_auto_window_ms 内开放，判定成功即永久锁定。                 */
  81:remote/rc_dbus.c **** /* ------------------------------------------------------------------ */
  82:remote/rc_dbus.c **** #define RC_SW_AUTO_HOLD_MS      1000    /* 条件需连续保持多少毫秒 */
  83:remote/rc_dbus.c **** #define RC_SW_AUTO_WINDOW_MS    3000    /* 上电后多久内允许自动判定 */
  84:remote/rc_dbus.c **** 
  85:remote/rc_dbus.c **** #define RC_OBS_NONE      0              /* 两个位域都在中位 */
  86:remote/rc_dbus.c **** #define RC_OBS_LO_MOVED  1              /* 只有 bit4~5 离开中位 */
  87:remote/rc_dbus.c **** #define RC_OBS_HI_MOVED  2              /* 只有 bit6~7 离开中位 */
  88:remote/rc_dbus.c **** #define RC_OBS_INVALID   3              /* 两个都离开中位 → 本段不计 */
ARM GAS  C:\Users\elaina\AppData\Local\Temp\cc9evgfd.s 			page 3


  89:remote/rc_dbus.c **** 
  90:remote/rc_dbus.c **** void RC_SwitchAutoName(void)
  91:remote/rc_dbus.c **** {
  92:remote/rc_dbus.c ****     uint32_t now = HAL_GetTick();
  93:remote/rc_dbus.c **** 
  94:remote/rc_dbus.c ****     if (RC_Data.sw_auto_done)
  95:remote/rc_dbus.c ****     {
  96:remote/rc_dbus.c ****         return;                                     /* 已锁定，永不改写 */
  97:remote/rc_dbus.c ****     }
  98:remote/rc_dbus.c **** 
  99:remote/rc_dbus.c ****     /* 第一帧到达时开判定窗口（此前的上电时间不计入窗口） */
 100:remote/rc_dbus.c ****     if (RC_Data.sw_first_frame_ms == 0)
 101:remote/rc_dbus.c ****     {
 102:remote/rc_dbus.c ****         RC_Data.sw_first_frame_ms = now ? now : 1u;
 103:remote/rc_dbus.c ****         RC_Data.sw_obs_start_ms   = 0;
 104:remote/rc_dbus.c ****         RC_Data.sw_obs_last       = RC_OBS_NONE;
 105:remote/rc_dbus.c ****         RC_Data.sw_obs_hold       = 0;
 106:remote/rc_dbus.c ****     }
 107:remote/rc_dbus.c **** 
 108:remote/rc_dbus.c ****     if ((now - RC_Data.sw_first_frame_ms) > RC_SW_AUTO_WINDOW_MS)
 109:remote/rc_dbus.c ****     {
 110:remote/rc_dbus.c ****         return;                                     /* 窗口已过 → 保持默认，永久放弃
 111:remote/rc_dbus.c ****     }
 112:remote/rc_dbus.c **** 
 113:remote/rc_dbus.c ****     /* 本帧观测：必须“恰好一个位域非中位”才有信息量 */
 114:remote/rc_dbus.c ****     uint8_t lo_mid = (RC_Data.sw_lo2 == RC_SW_MID) ? 1u : 0u;
 115:remote/rc_dbus.c ****     uint8_t hi_mid = (RC_Data.sw_hi2 == RC_SW_MID) ? 1u : 0u;
 116:remote/rc_dbus.c ****     uint8_t obs;
 117:remote/rc_dbus.c **** 
 118:remote/rc_dbus.c ****     if (lo_mid && hi_mid)        obs = RC_OBS_NONE;
 119:remote/rc_dbus.c ****     else if (!lo_mid && hi_mid)  obs = RC_OBS_LO_MOVED;
 120:remote/rc_dbus.c ****     else if (lo_mid && !hi_mid)  obs = RC_OBS_HI_MOVED;
 121:remote/rc_dbus.c ****     else                         obs = RC_OBS_INVALID;
 122:remote/rc_dbus.c **** 
 123:remote/rc_dbus.c ****     if ((obs != RC_Data.sw_obs_last) || (obs == RC_OBS_NONE) || (obs == RC_OBS_INVALID))
 124:remote/rc_dbus.c ****     {
 125:remote/rc_dbus.c ****         /* 观测状态变了（或本段无信息量）→ 重新开始计时 */
 126:remote/rc_dbus.c ****         RC_Data.sw_obs_last     = obs;
 127:remote/rc_dbus.c ****         RC_Data.sw_obs_hold     = 0;
 128:remote/rc_dbus.c ****         RC_Data.sw_obs_start_ms = (obs == RC_OBS_LO_MOVED || obs == RC_OBS_HI_MOVED) ? now : 0u;
 129:remote/rc_dbus.c ****         return;
 130:remote/rc_dbus.c ****     }
 131:remote/rc_dbus.c **** 
 132:remote/rc_dbus.c ****     if (RC_Data.sw_obs_hold < 250u)
 133:remote/rc_dbus.c ****     {
 134:remote/rc_dbus.c ****         RC_Data.sw_obs_hold++;
 135:remote/rc_dbus.c ****     }
 136:remote/rc_dbus.c **** 
 137:remote/rc_dbus.c ****     if (((RC_Data.sw_obs_start_ms != 0u) ? (now - RC_Data.sw_obs_start_ms)
 138:remote/rc_dbus.c ****                                         : 0u) >= RC_SW_AUTO_HOLD_MS)
 139:remote/rc_dbus.c ****     {
 140:remote/rc_dbus.c ****         /* 连续 1 秒只有一方离开中位 → 判定完成并永久锁定 */
 141:remote/rc_dbus.c ****         RC_Data.sw_auto_result = (obs == RC_OBS_HI_MOVED) ? 1u : 0u;
 142:remote/rc_dbus.c ****         RC_Data.sw_swap        = RC_Data.sw_auto_result;
 143:remote/rc_dbus.c ****         RC_Data.sw_auto_done   = 1u;
 144:remote/rc_dbus.c ****     }
 145:remote/rc_dbus.c **** }
