 195:remote/rc_dbus.c **** uint8_t RC_IsOnline(uint32_t now_ms)
 196:remote/rc_dbus.c **** {
 197:remote/rc_dbus.c ****     if ((now_ms - RC_Data.last_tick) > RC_OFFLINE_MS)
 198:remote/rc_dbus.c ****         RC_Data.online = 0;
 199:remote/rc_dbus.c ****     return RC_Data.online;
 200:remote/rc_dbus.c **** }
