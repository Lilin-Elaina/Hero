 531:modules/ins.c ****     /* ---- 零偏标定 ---- */
 532:modules/ins.c ****     if (INS_CalDone == 0u) {
 533:modules/ins.c ****         for (i = 0; i < 3; i++) {
 534:modules/ins.c ****             s_sum[i] += g[i];
 535:modules/ins.c ****             INS_Gyro[i] = 0.0f;
 536:modules/ins.c ****         }
 537:modules/ins.c ****         INS_CalCnt++;
 538:modules/ins.c **** 
 539:modules/ins.c ****         /* 标定过程中动过 → 作废重来，不能带着动过的样本收零偏 */
 540:modules/ins.c ****         if (max_dps > (INS_CAL_MAX_DPS * 0.0174532925f)) {
 541:modules/ins.c ****             INS_Err |= 0x02u;
 542:modules/ins.c ****             for (i = 0; i < 3; i++) {
 543:modules/ins.c ****                 s_sum[i] = 0.0f;
 544:modules/ins.c ****             }
 545:modules/ins.c ****             INS_CalCnt = 0;
 546:modules/ins.c ****             return;
 547:modules/ins.c ****         }
 548:modules/ins.c **** 
 549:modules/ins.c ****         if (INS_CalCnt >= INS_CAL_SAMPLES) {
 550:modules/ins.c ****             for (i = 0; i < 3; i++) {
 551:modules/ins.c ****                 INS_Bias[i] = s_sum[i] / (float)INS_CAL_SAMPLES;
 552:modules/ins.c ****             }
 553:modules/ins.c ****             INS_CalDone = 1;
 554:modules/ins.c ****         }
 555:modules/ins.c ****         return;
 556:modules/ins.c ****     }
 557:modules/ins.c **** 
 558:modules/ins.c ****     /* ---- 去零偏 + 一阶低通 ---- */
 559:modules/ins.c ****     for (i = 0; i < 3; i++) {
 560:modules/ins.c ****         float v = g[i] - INS_Bias[i];
 561:modules/ins.c ****         INS_Gyro[i] += (v - INS_Gyro[i]) * INS_GYRO_LPF;
 562:modules/ins.c ****     }
