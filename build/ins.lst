  77:modules/ins.c **** volatile int16_t  INS_GyroRaw[3];
  78:modules/ins.c **** volatile float    INS_Acc[3];
  79:modules/ins.c **** volatile float    INS_Gyro[3];
  80:modules/ins.c **** volatile float    INS_Bias[3];
