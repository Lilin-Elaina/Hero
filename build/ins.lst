 291:modules/imu/ins.c **** /**
 292:modules/imu/ins.c ****   * @brief  抓取两个芯片 0x00~0x0F 的寄存器快照（只在初始化后调用一次）
 293:modules/imu/ins.c ****   */
 294:modules/imu/ins.c **** static void ins_dump(void)
 295:modules/imu/ins.c **** {
 296:modules/imu/ins.c ****     uint8_t i;
 297:modules/imu/ins.c **** 
 298:modules/imu/ins.c ****     /* [0..2] 是偏移探测结果、[3] 是选中的哑字节数，这里只覆盖 [4..15] */
 299:modules/imu/ins.c ****     for (i = 4u; i < 16u; i++) {
 300:modules/imu/ins.c ****         ins_read(DEV_ACC,  i, (uint8_t *)&INS_AccDump[i],  1u);
 301:modules/imu/ins.c ****         ins_read(DEV_GYRO, i, (uint8_t *)&INS_GyroDump[i], 1u);
 302:modules/imu/ins.c ****     }
 303:modules/imu/ins.c **** }
 304:modules/imu/ins.c **** 
