 231:modules/ins.c **** 
 232:modules/ins.c ****     /* 先把电平置高（未选中），再切成输出，避免切换瞬间误选通 */
 233:modules/ins.c ****     HAL_GPIO_WritePin(GPIOC, GPIO_PIN_0 | GPIO_PIN_3, GPIO_PIN_SET);
