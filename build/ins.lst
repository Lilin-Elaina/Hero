 352:modules/ins.c **** /**
 353:modules/ins.c ****   * @brief  片选脚初始化 + H7 模拟开关
 354:modules/ins.c ****   * @note   PC0/PC3 在 CubeMX 里没配成输出（gpio.c 只管了 PD2），
 355:modules/ins.c ****   *         不在这里配的话片选是悬空的，芯片永远不会被选中 → 读回 0x00�
 356:modules/ins.c ****   */
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccQUlUxk.s 			page 21


 357:modules/ins.c **** static void ins_gpio_init(void)
 358:modules/ins.c **** {
 359:modules/ins.c ****     GPIO_InitTypeDef g = {0};
 360:modules/ins.c **** 
 361:modules/ins.c ****     __HAL_RCC_GPIOC_CLK_ENABLE();
 362:modules/ins.c ****     __HAL_RCC_SYSCFG_CLK_ENABLE();
 363:modules/ins.c **** 
 364:modules/ins.c ****     /* 先把电平置高（未选中），再切成输出，避免切换瞬间误选通 */
 365:modules/ins.c ****     HAL_GPIO_WritePin(GPIOC, GPIO_PIN_0 | GPIO_PIN_3, GPIO_PIN_SET);
 366:modules/ins.c **** 
 367:modules/ins.c ****     g.Pin   = GPIO_PIN_0 | GPIO_PIN_3;
 368:modules/ins.c ****     g.Mode  = GPIO_MODE_OUTPUT_PP;
 369:modules/ins.c ****     g.Pull  = GPIO_NOPULL;
 370:modules/ins.c ****     g.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
 371:modules/ins.c ****     HAL_GPIO_Init(GPIOC, &g);
 372:modules/ins.c **** 
 373:modules/ins.c ****     /* H7 的 PC2_C/PC3_C 与 PC2/PC3 之间有模拟开关，不闭合则引脚不通 */
 374:modules/ins.c ****     HAL_SYSCFG_AnalogSwitchConfig(SYSCFG_SWITCH_PC2, SYSCFG_SWITCH_PC2_CLOSE);
 375:modules/ins.c ****     HAL_SYSCFG_AnalogSwitchConfig(SYSCFG_SWITCH_PC3, SYSCFG_SWITCH_PC3_CLOSE);
 376:modules/ins.c **** }
