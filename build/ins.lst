  32:modules/ins.c **** /* ======================= 寄存器 ======================= */
  33:modules/ins.c **** /* 加速度计 */
  34:modules/ins.c **** #define ACC_CHIP_ID     0x00u
  35:modules/ins.c **** #define ACC_DATA        0x12u
  36:modules/ins.c **** #define ACC_CONF        0x40u
  37:modules/ins.c **** #define ACC_RANGE       0x41u
  38:modules/ins.c **** #define ACC_PWR_CONF    0x7Cu
  39:modules/ins.c **** #define ACC_PWR_CTRL    0x7Du
  40:modules/ins.c **** #define ACC_SOFTRESET   0x7Eu
  41:modules/ins.c **** 
  42:modules/ins.c **** /* 陀螺 */
  43:modules/ins.c **** #define GYRO_CHIP_ID    0x00u
  44:modules/ins.c **** #define GYRO_RATE_DATA  0x02u
  45:modules/ins.c **** #define GYRO_RANGE      0x0Fu
  46:modules/ins.c **** #define GYRO_BANDWIDTH  0x10u
  47:modules/ins.c **** #define GYRO_LPM1       0x11u
  48:modules/ins.c **** #define GYRO_SOFTRESET  0x14u
  49:modules/ins.c **** 
  50:modules/ins.c **** #define ACC_CHIP_ID_VAL   0x1Eu
  51:modules/ins.c **** #define GYRO_CHIP_ID_VAL  0x0Fu
  52:modules/ins.c **** #define BMI_SOFTRESET_VAL 0xB6u
  53:modules/ins.c **** 
  54:modules/ins.c **** /* ======================= 量程 ======================= */
  55:modules/ins.c **** /* 加速度 ±6g */
  56:modules/ins.c **** #define INS_ACC_LSB     (6.0f * 9.80665f / 32768.0f)
  57:modules/ins.c **** /* 陀螺 ±2000 dps */
  58:modules/ins.c **** #define INS_GYRO_LSB    (2000.0f * 0.0174532925f / 32768.0f)
  59:modules/ins.c **** 
  60:modules/ins.c **** /* 零偏标定拍数（1 kHz 下 2 s） */
  61:modules/ins.c **** #define INS_CAL_SAMPLES   2000u
  62:modules/ins.c **** /* 标定期间角速度超此值判为「动过了」，结果不可信 */
  63:modules/ins.c **** #define INS_CAL_MAX_DPS   5.0f
  64:modules/ins.c **** /* 一阶低通系数：0.333 ≈ 100 Hz @1 kHz */
  65:modules/ins.c **** #define INS_GYRO_LPF      0.3333f
  66:modules/ins.c **** 
