   1:modules/ins.c **** /**
   2:modules/ins.c ****   ******************************************************************************
   3:modules/ins.c ****   * @file    ins.c
   4:modules/ins.c ****   * @brief   BMI088 驱动（SPI2 + 双片选），只做「读角速度」这一件事
   5:modules/ins.c ****   *
   6:modules/ins.c ****   *  片上资源：
   7:modules/ins.c ****   *    SPI2  : PB13=SCK  PC2_C=MISO  PC1=MOSI   （CPOL=High, CPHA=2Edge, 4.125MHz）
   8:modules/ins.c ****   *    CS    : PC0 = 加速度计,  PC3 = 陀螺      （低有效）
   9:modules/ins.c ****   ******************************************************************************
  10:modules/ins.c ****   */
  11:modules/ins.c **** 
  12:modules/ins.c **** #include "ins.h"
  13:modules/ins.c **** #include "spi.h"
  14:modules/ins.c **** #include "main.h"
  15:modules/ins.c **** #include <string.h>
  16:modules/ins.c **** 
  17:modules/ins.c **** /* ======================= 引脚 ======================= */
  18:modules/ins.c **** #define INS_CS_PORT        GPIOC
  19:modules/ins.c **** #define INS_CS_ACC_PIN     GPIO_PIN_0
  20:modules/ins.c **** #define INS_CS_GYRO_PIN    GPIO_PIN_3
  21:modules/ins.c **** 
  22:modules/ins.c **** #define INS_CS_ACC_LOW()   HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_ACC_PIN,  GPIO_PIN_RESET)
  23:modules/ins.c **** #define INS_CS_ACC_HIGH()  HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_ACC_PIN,  GPIO_PIN_SET)
  24:modules/ins.c **** #define INS_CS_GYRO_LOW()  HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_GYRO_PIN, GPIO_PIN_RESET)
  25:modules/ins.c **** #define INS_CS_GYRO_HIGH() HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_GYRO_PIN, GPIO_PIN_SET)
  26:modules/ins.c **** 
  27:modules/ins.c **** /* dev: 0 = 加速度计, 1 = 陀螺 */
  28:modules/ins.c **** #define DEV_ACC   0u
  29:modules/ins.c **** #define DEV_GYRO  1u
  30:modules/ins.c **** 
  31:modules/ins.c **** /* ======================= 寄存器 ======================= */
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccKlfqTa.s 			page 2


  32:modules/ins.c **** /* 加速度计 */
  33:modules/ins.c **** #define ACC_CHIP_ID     0x00u
  34:modules/ins.c **** #define ACC_DATA        0x12u
  35:modules/ins.c **** #define ACC_CONF        0x40u
  36:modules/ins.c **** #define ACC_RANGE       0x41u
  37:modules/ins.c **** #define ACC_PWR_CONF    0x7Cu
  38:modules/ins.c **** #define ACC_PWR_CTRL    0x7Du
  39:modules/ins.c **** #define ACC_SOFTRESET   0x7Eu
  40:modules/ins.c **** 
  41:modules/ins.c **** /* 陀螺 */
  42:modules/ins.c **** #define GYRO_CHIP_ID    0x00u
  43:modules/ins.c **** #define GYRO_RATE_DATA  0x02u
  44:modules/ins.c **** #define GYRO_RANGE      0x0Fu
  45:modules/ins.c **** #define GYRO_BANDWIDTH  0x10u
  46:modules/ins.c **** #define GYRO_LPM1       0x11u
  47:modules/ins.c **** #define GYRO_SOFTRESET  0x14u
  48:modules/ins.c **** 
  49:modules/ins.c **** #define ACC_CHIP_ID_VAL   0x1Eu
  50:modules/ins.c **** #define GYRO_CHIP_ID_VAL  0x0Fu
  51:modules/ins.c **** #define BMI_SOFTRESET_VAL 0xB6u
  52:modules/ins.c **** 
  53:modules/ins.c **** /* ======================= 量程 ======================= */
  54:modules/ins.c **** /* 加速度 ±6g */
  55:modules/ins.c **** #define INS_ACC_LSB     (6.0f * 9.80665f / 32768.0f)
  56:modules/ins.c **** /* 陀螺 ±2000 dps */
  57:modules/ins.c **** #define INS_GYRO_LSB    (2000.0f * 0.0174532925f / 32768.0f)
  58:modules/ins.c **** 
  59:modules/ins.c **** /* 零偏标定拍数（1 kHz 下 2 s） */
  60:modules/ins.c **** #define INS_CAL_SAMPLES   2000u
  61:modules/ins.c **** /* 标定期间角速度超此值判为「动过了」，结果不可信 */
  62:modules/ins.c **** #define INS_CAL_MAX_DPS   5.0f
  63:modules/ins.c **** /* 一阶低通系数：0.333 ≈ 100 Hz @1 kHz */
  64:modules/ins.c **** #define INS_GYRO_LPF      0.3333f
  65:modules/ins.c **** 
