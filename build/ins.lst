  84:modules/imu/ins.c **** /* ======================= Mahony 姿态解算 =======================
  85:modules/imu/ins.c ****  * 目的：拿到「世界垂直轴」上的角速度。板子竖直绑在枪架上，体轴 x 指
  86:modules/imu/ins.c ****  * pitch 一动 x 轴就离开竖直，-Gyro[0] 不再是世界偏航角速度，必须用重力
  87:modules/imu/ins.c ****  * 方向把陀螺投影到竖直轴上：ω_world = ω·v，v = 世界“上”在体轴系的投�
  88:modules/imu/ins.c ****  * 无磁力计 → 偏航角靠陀螺积分，零偏偏移会让 INS_WorldYaw 缓慢漂移（正�
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccSX3o5o.s 			page 3


  89:modules/imu/ins.c ****  */
  90:modules/imu/ins.c **** #define MAHONY_KP        10.0f
  91:modules/imu/ins.c **** #define MAHONY_KI        0.008f
  92:modules/imu/ins.c **** #define MAHONY_HALFT     0.0005f      /* 1 kHz 的半个采样周期 */
  93:modules/imu/ins.c **** #define MAHONY_DT        0.001f
  94:modules/imu/ins.c **** #define MAHONY_ACC_GATE  1.5f         /* |a| 偏离 1g 超此值(m/s^2) → 重力修正降到 10% 
  95:modules/imu/ins.c **** #define MAHONY_WARMUP    1000u        /* 收敛 1 s 后才对外发布 */
  96:modules/imu/ins.c **** /* 世界垂直轴 = SIGN·(ω·v)，v = 世界“上”在体轴系的投影。
  97:modules/imu/ins.c ****  * 判据：静止水平时它必须等于既有约定 ω_yaw = -Gyro[0]。
  98:modules/imu/ins.c ****  * 板子 x 轴朝下（所以当年才要那个负号）→ a_x≈-9.8 → v≈(-1,0,0)
  99:modules/imu/ins.c ****  * → g·v = -g0 → 要再取负一次才是 -g0，故 SIGN = +1。 */
 100:modules/imu/ins.c **** #define INS_WORLD_YAW_SIGN  (+1.0f)
 101:modules/imu/ins.c **** 
 102:modules/imu/ins.c **** volatile float   INS_WorldYawRate;
 103:modules/imu/ins.c **** volatile float   INS_WorldYaw;
 104:modules/imu/ins.c **** volatile float   INS_RollDeg;
 105:modules/imu/ins.c **** volatile float   INS_PitchDeg;
 106:modules/imu/ins.c **** volatile uint8_t INS_AhrsReady;
 107:modules/imu/ins.c **** 
 108:modules/imu/ins.c **** static float    s_q0 = 1.0f, s_q1 = 0.0f, s_q2 = 0.0f, s_q3 = 0.0f;
 109:modules/imu/ins.c **** static float    s_exi, s_eyi, s_ezi;
 110:modules/imu/ins.c **** static uint16_t s_ahrs_cnt;
 111:modules/imu/ins.c **** 
 112:modules/imu/ins.c **** static void ins_ahrs_step(float gx, float gy, float gz, float ax, float ay, float az)
 113:modules/imu/ins.c **** {
 114:modules/imu/ins.c ****     float norm = sqrtf(ax * ax + ay * ay + az * az);
 115:modules/imu/ins.c ****     float vx, vy, vz, ex, ey, ez, kp;
 116:modules/imu/ins.c ****     float q0q0, q0q1, q0q2, q1q1, q1q3, q2q2, q2q3, q3q3;
 117:modules/imu/ins.c ****     float t0, t1, t2, t3;
 118:modules/imu/ins.c ****     float gx_r = gx, gy_r = gy, gz_r = gz;
 119:modules/imu/ins.c **** 
 120:modules/imu/ins.c ****     if (norm < 1.0f) {                    /* 数据无效，本拍跳过 */
 121:modules/imu/ins.c ****         return;
 122:modules/imu/ins.c ****     }
 123:modules/imu/ins.c **** 
 124:modules/imu/ins.c ****     ax /= norm;
 125:modules/imu/ins.c ****     ay /= norm;
 126:modules/imu/ins.c ****     az /= norm;
 127:modules/imu/ins.c **** 
 128:modules/imu/ins.c ****     q0q0 = s_q0 * s_q0;
 129:modules/imu/ins.c ****     q0q1 = s_q0 * s_q1;
 130:modules/imu/ins.c ****     q0q2 = s_q0 * s_q2;
 131:modules/imu/ins.c ****     q1q1 = s_q1 * s_q1;
 132:modules/imu/ins.c ****     q1q3 = s_q1 * s_q3;
 133:modules/imu/ins.c ****     q2q2 = s_q2 * s_q2;
 134:modules/imu/ins.c ****     q2q3 = s_q2 * s_q3;
 135:modules/imu/ins.c ****     q3q3 = s_q3 * s_q3;
 136:modules/imu/ins.c **** 
 137:modules/imu/ins.c ****     /* 估计的重力方向（世界“上”在体轴系） */
 138:modules/imu/ins.c ****     vx = 2.0f * (q1q3 - q0q2);
 139:modules/imu/ins.c ****     vy = 2.0f * (q0q1 + q2q3);
 140:modules/imu/ins.c ****     vz = q0q0 - q1q1 - q2q2 + q3q3;
 141:modules/imu/ins.c **** 
 142:modules/imu/ins.c ****     /* 实测重力与估计重力的叉积 = 姿态误差 */
 143:modules/imu/ins.c ****     ex = ay * vz - az * vy;
 144:modules/imu/ins.c ****     ey = az * vx - ax * vz;
 145:modules/imu/ins.c ****     ez = ax * vy - ay * vx;
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccSX3o5o.s 			page 4


 146:modules/imu/ins.c **** 
 147:modules/imu/ins.c ****     /* 机体线加速度大时加速度计不可信，削弱修正，避免把姿态带偏 */
 148:modules/imu/ins.c ****     kp = MAHONY_KP;
 149:modules/imu/ins.c ****     if (fabsf(norm - 9.80665f) > MAHONY_ACC_GATE) {
 150:modules/imu/ins.c ****         kp *= 0.1f;
 151:modules/imu/ins.c ****     }
 152:modules/imu/ins.c **** 
 153:modules/imu/ins.c ****     s_exi += ex * (MAHONY_KI * MAHONY_DT);
 154:modules/imu/ins.c ****     s_eyi += ey * (MAHONY_KI * MAHONY_DT);
 155:modules/imu/ins.c ****     s_ezi += ez * (MAHONY_KI * MAHONY_DT);
 156:modules/imu/ins.c **** 
 157:modules/imu/ins.c ****     gx += kp * ex + s_exi;
 158:modules/imu/ins.c ****     gy += kp * ey + s_eyi;
 159:modules/imu/ins.c ****     gz += kp * ez + s_ezi;
 160:modules/imu/ins.c **** 
 161:modules/imu/ins.c ****     /* 四元数积分 */
 162:modules/imu/ins.c ****     t0 = s_q0;
 163:modules/imu/ins.c ****     t1 = s_q1;
 164:modules/imu/ins.c ****     t2 = s_q2;
 165:modules/imu/ins.c ****     t3 = s_q3;
 166:modules/imu/ins.c ****     s_q0 += (-t1 * gx - t2 * gy - t3 * gz) * MAHONY_HALFT;
 167:modules/imu/ins.c ****     s_q1 += ( t0 * gx + t2 * gz - t3 * gy) * MAHONY_HALFT;
 168:modules/imu/ins.c ****     s_q2 += ( t0 * gy - t1 * gz + t3 * gx) * MAHONY_HALFT;
 169:modules/imu/ins.c ****     s_q3 += ( t0 * gz + t1 * gy - t2 * gx) * MAHONY_HALFT;
 170:modules/imu/ins.c **** 
 171:modules/imu/ins.c ****     /* 归一化 */
 172:modules/imu/ins.c ****     norm = sqrtf(s_q0 * s_q0 + s_q1 * s_q1 + s_q2 * s_q2 + s_q3 * s_q3);
 173:modules/imu/ins.c ****     if (norm < 1e-6f) {
 174:modules/imu/ins.c ****         s_q0 = 1.0f; s_q1 = 0.0f; s_q2 = 0.0f; s_q3 = 0.0f;
 175:modules/imu/ins.c ****         return;
 176:modules/imu/ins.c ****     }
 177:modules/imu/ins.c ****     s_q0 /= norm;
 178:modules/imu/ins.c ****     s_q1 /= norm;
 179:modules/imu/ins.c ****     s_q2 /= norm;
 180:modules/imu/ins.c ****     s_q3 /= norm;
 181:modules/imu/ins.c **** 
 182:modules/imu/ins.c ****     /* 用更新后的姿态重算竖直轴，把实测角速度投影上去（倾斜补偿的核�
 183:modules/imu/ins.c ****     q0q0 = s_q0 * s_q0;
 184:modules/imu/ins.c ****     q0q1 = s_q0 * s_q1;
 185:modules/imu/ins.c ****     q0q2 = s_q0 * s_q2;
 186:modules/imu/ins.c ****     q1q1 = s_q1 * s_q1;
 187:modules/imu/ins.c ****     q1q3 = s_q1 * s_q3;
 188:modules/imu/ins.c ****     q2q2 = s_q2 * s_q2;
 189:modules/imu/ins.c ****     q2q3 = s_q2 * s_q3;
 190:modules/imu/ins.c ****     q3q3 = s_q3 * s_q3;
 191:modules/imu/ins.c ****     vx = 2.0f * (q1q3 - q0q2);
 192:modules/imu/ins.c ****     vy = 2.0f * (q0q1 + q2q3);
 193:modules/imu/ins.c ****     vz = q0q0 - q1q1 - q2q2 + q3q3;
 194:modules/imu/ins.c **** 
 195:modules/imu/ins.c ****     /* 负号是为了和既有约定 ω_yaw = -INS_Gyro[0] 对齐（静止水平时两者相等）
 196:modules/imu/ins.c ****     INS_WorldYawRate = INS_WORLD_YAW_SIGN * (gx_r * vx + gy_r * vy + gz_r * vz) * 57.2957795f;
 197:modules/imu/ins.c **** 
 198:modules/imu/ins.c ****     if (s_ahrs_cnt < MAHONY_WARMUP) {
 199:modules/imu/ins.c ****         s_ahrs_cnt++;
 200:modules/imu/ins.c ****         if (s_ahrs_cnt == MAHONY_WARMUP) {
 201:modules/imu/ins.c ****             INS_AhrsReady = 1u;
 202:modules/imu/ins.c ****         }
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccSX3o5o.s 			page 5


 203:modules/imu/ins.c ****         return;                     /* 收敛期内只跑姿态，不发布积分 */
 204:modules/imu/ins.c ****     }
 205:modules/imu/ins.c **** 
 206:modules/imu/ins.c ****     INS_WorldYaw += INS_WorldYawRate * MAHONY_DT;
 207:modules/imu/ins.c ****     if (INS_WorldYaw >  36000.0f) INS_WorldYaw -= 72000.0f;
 208:modules/imu/ins.c ****     if (INS_WorldYaw < -36000.0f) INS_WorldYaw += 72000.0f;
 209:modules/imu/ins.c **** 
 210:modules/imu/ins.c ****     /* 调试：传感器体系下的欧拉角 */
 211:modules/imu/ins.c ****     INS_RollDeg  = atan2f(2.0f * (q2q3 + q0q1), 1.0f - 2.0f * (q1q1 + q2q2)) * 57.2957795f;
 212:modules/imu/ins.c ****     INS_PitchDeg = asinf(2.0f * (q0q2 - q1q3)) * 57.2957795f;
 213:modules/imu/ins.c **** }
