 166:modules/ins.c **** /* ======================= 初始化 ======================= */
 167:modules/ins.c **** 
 168:modules/ins.c **** /**
 169:modules/ins.c ****   * @brief  抓取两个芯片 0x00~0x0F 的寄存器快照（只在初始化后调用一次）
 170:modules/ins.c ****   */
 171:modules/ins.c **** static void ins_dump(void)
 172:modules/ins.c **** {
 173:modules/ins.c ****     uint8_t i;
 174:modules/ins.c **** 
 175:modules/ins.c ****     /* [0..2] 是偏移探测结果、[3] 是选中的哑字节数，这里只覆盖 [4..15] */
 176:modules/ins.c ****     for (i = 4u; i < 16u; i++) {
 177:modules/ins.c ****         ins_read(DEV_ACC,  i, (uint8_t *)&INS_AccDump[i],  1u);
 178:modules/ins.c ****         ins_read(DEV_GYRO, i, (uint8_t *)&INS_GyroDump[i], 1u);
 179:modules/ins.c ****     }
 180:modules/ins.c **** }
 181:modules/ins.c **** 
 182:modules/ins.c **** /**
 183:modules/ins.c ****   * @brief  探测 SPI 读偏移（要丢几个哑字节）
 184:modules/ins.c ****   * @note   对每个芯片用 skip = 0/1/2 各读一次 CHIP_ID：
 185:modules/ins.c ****   *           INS_xxxDump[0..2] = 三次读到的值
 186:modules/ins.c ****   *           INS_xxxDump[3]    = 最终选中的 skip
 187:modules/ins.c ****   *         谁先读到正确 ID（acc 0x1E / gyro 0x0F）就用谁；
 188:modules/ins.c ****   *         一个都对不上就退回默认 acc=1 / gyro=0。
 189:modules/ins.c ****   */
 190:modules/ins.c **** static void ins_detect_skip(void)
 191:modules/ins.c **** {
