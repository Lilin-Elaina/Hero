  89:modules/ins.c **** /* ======================= Mahony 姿态解算 =======================
  90:modules/ins.c ****  * 目的：拿到「世界垂直轴」上的角速度。板子竖直绑在枪架上，体轴 x 指
  91:modules/ins.c ****  * pitch 一动 x 轴就离开竖直，-Gyro[0] 不再是世界偏航角速度，必须用重力
  92:modules/ins.c ****  * 方向把陀螺投影到竖直轴上：ω_world = ω·v，v = 世界“上”在体轴系的投�
  93:modules/ins.c ****  * 无磁力计 → 偏航角靠陀螺积分，零偏偏移会让 INS_WorldYaw 缓慢漂移（正�
  94:modules/ins.c ****  */
  95:modules/ins.c **** #define MAHONY_KP        10.0f
  96:modules/ins.c **** #define MAHONY_KI        0.008f
  97:modules/ins.c **** #define MAHONY_HALFT     0.0005f      /* 1 kHz 的半个采样周期 */
  98:modules/ins.c **** #define MAHONY_DT        0.001f
  99:modules/ins.c **** #define MAHONY_ACC_GATE  1.5f         /* |a| 偏离 1g 超此值(m/s^2) → 重力修正降到 10% 
 100:modules/ins.c **** #define MAHONY_WARMUP    1000u        /* 收敛 1 s 后才对外发布 */
 101:modules/ins.c **** /* 世界垂直轴 = SIGN·(ω·v)，v = 世界“上”在体轴系的投影。
 102:modules/ins.c ****  * 判据：静止水平时它必须等于既有约定 ω_yaw = -Gyro[0]。
 103:modules/ins.c ****  * 板子 x 轴朝下（所以当年才要那个负号）→ a_x≈-9.8 → v≈(-1,0,0)
 104:modules/ins.c ****  * → g·v = -g0 → 要再取负一次才是 -g0，故 SIGN = +1。 */
 105:modules/ins.c **** #define INS_WORLD_YAW_SIGN  (+1.0f)
 106:modules/ins.c **** 
 107:modules/ins.c **** volatile float   INS_WorldYawRate;
 108:modules/ins.c **** volatile float   INS_WorldYaw;
 109:modules/ins.c **** volatile float   INS_RollDeg;
 110:modules/ins.c **** volatile float   INS_PitchDeg;
 111:modules/ins.c **** volatile uint8_t INS_AhrsReady;
 112:modules/ins.c **** 
 113:modules/ins.c **** static float    s_q0 = 1.0f, s_q1 = 0.0f, s_q2 = 0.0f, s_q3 = 0.0f;
 114:modules/ins.c **** static float    s_exi, s_eyi, s_ezi;
 115:modules/ins.c **** static uint16_t s_ahrs_cnt;
 116:modules/ins.c **** 
 117:modules/ins.c **** static void ins_ahrs_step(float gx, float gy, float gz, float ax, float ay, float az)
 118:modules/ins.c **** {
 119:modules/ins.c ****     float norm = sqrtf(ax * ax + ay * ay + az * az);
 120:modules/ins.c ****     float vx, vy, vz, ex, ey, ez, kp;
 121:modules/ins.c ****     float q0q0, q0q1, q0q2, q1q1, q1q3, q2q2, q2q3, q3q3;
 122:modules/ins.c ****     float t0, t1, t2, t3;
 123:modules/ins.c ****     float gx_r = gx, gy_r = gy, gz_r = gz;
 124:modules/ins.c **** 
 125:modules/ins.c ****     if (norm < 1.0f) {                    /* 数据无效，本拍跳过 */
 126:modules/ins.c ****         return;
 127:modules/ins.c ****     }
 128:modules/ins.c **** 
 129:modules/ins.c ****     ax /= norm;
 130:modules/ins.c ****     ay /= norm;
 131:modules/ins.c ****     az /= norm;
 132:modules/ins.c **** 
 133:modules/ins.c ****     q0q0 = s_q0 * s_q0;
 134:modules/ins.c ****     q0q1 = s_q0 * s_q1;
 135:modules/ins.c ****     q0q2 = s_q0 * s_q2;
 136:modules/ins.c ****     q1q1 = s_q1 * s_q1;
 137:modules/ins.c ****     q1q3 = s_q1 * s_q3;
 138:modules/ins.c ****     q2q2 = s_q2 * s_q2;
 139:modules/ins.c ****     q2q3 = s_q2 * s_q3;
 140:modules/ins.c ****     q3q3 = s_q3 * s_q3;
 141:modules/ins.c **** 
 142:modules/ins.c ****     /* 估计的重力方向（世界“上”在体轴系） */
 143:modules/ins.c ****     vx = 2.0f * (q1q3 - q0q2);
 144:modules/ins.c ****     vy = 2.0f * (q0q1 + q2q3);
 145:modules/ins.c ****     vz = q0q0 - q1q1 - q2q2 + q3q3;
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccQUlUxk.s 			page 4


 146:modules/ins.c **** 
 147:modules/ins.c ****     /* 实测重力与估计重力的叉积 = 姿态误差 */
 148:modules/ins.c ****     ex = ay * vz - az * vy;
 149:modules/ins.c ****     ey = az * vx - ax * vz;
 150:modules/ins.c ****     ez = ax * vy - ay * vx;
 151:modules/ins.c **** 
 152:modules/ins.c ****     /* 机体线加速度大时加速度计不可信，削弱修正，避免把姿态带偏 */
 153:modules/ins.c ****     kp = MAHONY_KP;
 154:modules/ins.c ****     if (fabsf(norm - 9.80665f) > MAHONY_ACC_GATE) {
 155:modules/ins.c ****         kp *= 0.1f;
 156:modules/ins.c ****     }
 157:modules/ins.c **** 
 158:modules/ins.c ****     s_exi += ex * (MAHONY_KI * MAHONY_DT);
 159:modules/ins.c ****     s_eyi += ey * (MAHONY_KI * MAHONY_DT);
 160:modules/ins.c ****     s_ezi += ez * (MAHONY_KI * MAHONY_DT);
 161:modules/ins.c **** 
 162:modules/ins.c ****     gx += kp * ex + s_exi;
 163:modules/ins.c ****     gy += kp * ey + s_eyi;
 164:modules/ins.c ****     gz += kp * ez + s_ezi;
 165:modules/ins.c **** 
 166:modules/ins.c ****     /* 四元数积分 */
 167:modules/ins.c ****     t0 = s_q0;
 168:modules/ins.c ****     t1 = s_q1;
 169:modules/ins.c ****     t2 = s_q2;
 170:modules/ins.c ****     t3 = s_q3;
 171:modules/ins.c ****     s_q0 += (-t1 * gx - t2 * gy - t3 * gz) * MAHONY_HALFT;
 172:modules/ins.c ****     s_q1 += ( t0 * gx + t2 * gz - t3 * gy) * MAHONY_HALFT;
 173:modules/ins.c ****     s_q2 += ( t0 * gy - t1 * gz + t3 * gx) * MAHONY_HALFT;
 174:modules/ins.c ****     s_q3 += ( t0 * gz + t1 * gy - t2 * gx) * MAHONY_HALFT;
 175:modules/ins.c **** 
 176:modules/ins.c ****     /* 归一化 */
 177:modules/ins.c ****     norm = sqrtf(s_q0 * s_q0 + s_q1 * s_q1 + s_q2 * s_q2 + s_q3 * s_q3);
 178:modules/ins.c ****     if (norm < 1e-6f) {
 179:modules/ins.c ****         s_q0 = 1.0f; s_q1 = 0.0f; s_q2 = 0.0f; s_q3 = 0.0f;
 180:modules/ins.c ****         return;
 181:modules/ins.c ****     }
 182:modules/ins.c ****     s_q0 /= norm;
 183:modules/ins.c ****     s_q1 /= norm;
 184:modules/ins.c ****     s_q2 /= norm;
 185:modules/ins.c ****     s_q3 /= norm;
 186:modules/ins.c **** 
 187:modules/ins.c ****     /* 用更新后的姿态重算竖直轴，把实测角速度投影上去（倾斜补偿的核�
 188:modules/ins.c ****     q0q0 = s_q0 * s_q0;
 189:modules/ins.c ****     q0q1 = s_q0 * s_q1;
 190:modules/ins.c ****     q0q2 = s_q0 * s_q2;
 191:modules/ins.c ****     q1q1 = s_q1 * s_q1;
 192:modules/ins.c ****     q1q3 = s_q1 * s_q3;
 193:modules/ins.c ****     q2q2 = s_q2 * s_q2;
 194:modules/ins.c ****     q2q3 = s_q2 * s_q3;
 195:modules/ins.c ****     q3q3 = s_q3 * s_q3;
 196:modules/ins.c ****     vx = 2.0f * (q1q3 - q0q2);
 197:modules/ins.c ****     vy = 2.0f * (q0q1 + q2q3);
 198:modules/ins.c ****     vz = q0q0 - q1q1 - q2q2 + q3q3;
 199:modules/ins.c **** 
 200:modules/ins.c ****     /* 负号是为了和既有约定 ω_yaw = -INS_Gyro[0] 对齐（静止水平时两者相等）
 201:modules/ins.c ****     INS_WorldYawRate = INS_WORLD_YAW_SIGN * (gx_r * vx + gy_r * vy + gz_r * vz) * 57.2957795f;
 202:modules/ins.c **** 
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccQUlUxk.s 			page 5


 203:modules/ins.c ****     if (s_ahrs_cnt < MAHONY_WARMUP) {
 204:modules/ins.c ****         s_ahrs_cnt++;
 205:modules/ins.c ****         if (s_ahrs_cnt == MAHONY_WARMUP) {
 206:modules/ins.c ****             INS_AhrsReady = 1u;
 207:modules/ins.c ****         }
 208:modules/ins.c ****         return;                     /* 收敛期内只跑姿态，不发布积分 */
 209:modules/ins.c ****     }
 210:modules/ins.c **** 
 211:modules/ins.c ****     INS_WorldYaw += INS_WorldYawRate * MAHONY_DT;
 212:modules/ins.c ****     if (INS_WorldYaw >  36000.0f) INS_WorldYaw -= 72000.0f;
 213:modules/ins.c ****     if (INS_WorldYaw < -36000.0f) INS_WorldYaw += 72000.0f;
 214:modules/ins.c **** 
 215:modules/ins.c ****     /* 调试：传感器体系下的欧拉角 */
 216:modules/ins.c ****     INS_RollDeg  = atan2f(2.0f * (q2q3 + q0q1), 1.0f - 2.0f * (q1q1 + q2q2)) * 57.2957795f;
 217:modules/ins.c ****     INS_PitchDeg = asinf(2.0f * (q0q2 - q1q3)) * 57.2957795f;
 218:modules/ins.c **** }
