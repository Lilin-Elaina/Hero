   1:modules/imu/ins.c **** /**
   2:modules/imu/ins.c ****   ******************************************************************************
   3:modules/imu/ins.c ****   * @file    ins.c
   4:modules/imu/ins.c ****   * @brief   BMI088 驱动（SPI2 + 双片选），只做「读角速度」这一件事
   5:modules/imu/ins.c ****   *
   6:modules/imu/ins.c ****   *  片上资源：
   7:modules/imu/ins.c ****   *    SPI2  : PB13=SCK  PC2_C=MISO  PC1=MOSI   （CPOL=High, CPHA=2Edge, 4.125MHz）
   8:modules/imu/ins.c ****   *    CS    : PC0 = 加速度计,  PC3 = 陀螺      （低有效）
   9:modules/imu/ins.c ****   ******************************************************************************
  10:modules/imu/ins.c ****   */
  11:modules/imu/ins.c **** 
  12:modules/imu/ins.c **** #include "ins.h"
