  32:modules/imu/ins.c **** #define ACC_RANGE       0x41u
  33:modules/imu/ins.c **** #define ACC_PWR_CONF    0x7Cu
  34:modules/imu/ins.c **** #define ACC_PWR_CTRL    0x7Du
  35:modules/imu/ins.c **** #define ACC_SOFTRESET   0x7Eu
  36:modules/imu/ins.c **** 
  37:modules/imu/ins.c **** /* 陀螺 */
  38:modules/imu/ins.c **** #define GYRO_CHIP_ID    0x00u
  39:modules/imu/ins.c **** #define GYRO_RATE_DATA  0x02u
  40:modules/imu/ins.c **** #define GYRO_RANGE      0x0Fu
  41:modules/imu/ins.c **** #define GYRO_BANDWIDTH  0x10u
  42:modules/imu/ins.c **** #define GYRO_LPM1       0x11u
  43:modules/imu/ins.c **** #define GYRO_SOFTRESET  0x14u
  44:modules/imu/ins.c **** 
  45:modules/imu/ins.c **** #define ACC_CHIP_ID_VAL   0x1Eu
  46:modules/imu/ins.c **** #define GYRO_CHIP_ID_VAL  0x0Fu
  47:modules/imu/ins.c **** #define BMI_SOFTRESET_VAL 0xB6u
  48:modules/imu/ins.c **** 
  49:modules/imu/ins.c **** /* ======================= 量程 ======================= */
  50:modules/imu/ins.c **** /* 加速度 ±6g */
  51:modules/imu/ins.c **** #define INS_ACC_LSB     (6.0f * 9.80665f / 32768.0f)
  52:modules/imu/ins.c **** /* 陀螺 ±2000 dps */
  53:modules/imu/ins.c **** #define INS_GYRO_LSB    (2000.0f * 0.0174532925f / 32768.0f)
  54:modules/imu/ins.c **** 
  55:modules/imu/ins.c **** /* 零偏标定拍数（1 kHz 下 2 s） */
  56:modules/imu/ins.c **** #define INS_CAL_SAMPLES   2000u
  57:modules/imu/ins.c **** /* 标定期间角速度超此值判为「动过了」，结果不可信 */
  58:modules/imu/ins.c **** #define INS_CAL_MAX_DPS   5.0f
  59:modules/imu/ins.c **** /* 一阶低通系数：0.333 ≈ 100 Hz @1 kHz */
  60:modules/imu/ins.c **** #define INS_GYRO_LPF      0.3333f
