 247:modules/imu/ins.c **** 
 248:modules/imu/ins.c **** /**
 249:modules/imu/ins.c ****   * @brief  读寄存器（自动处理 SPI 的「空字节」）
 250:modules/imu/ins.c ****   * @note   哑字节个数取 s_skip_acc / s_skip_gyro（见上方说明）
 251:modules/imu/ins.c ****   */
 252:modules/imu/ins.c **** static uint8_t ins_read(uint8_t dev, uint8_t reg, uint8_t *buf, uint16_t len)
 253:modules/imu/ins.c **** {
 254:modules/imu/ins.c ****     uint8_t  tx[24];
 255:modules/imu/ins.c ****     uint8_t  rx[24];
 256:modules/imu/ins.c ****     uint16_t skip = (dev == DEV_ACC) ? s_skip_acc : s_skip_gyro;
 257:modules/imu/ins.c ****     uint16_t n    = (uint16_t)(1u + skip + len);
 258:modules/imu/ins.c ****     uint16_t i;
 259:modules/imu/ins.c **** 
 260:modules/imu/ins.c ****     if (n > sizeof(tx)) return 0u;
 261:modules/imu/ins.c **** 
 262:modules/imu/ins.c ****     memset(tx, 0, sizeof(tx));
 263:modules/imu/ins.c ****     memset(rx, 0, sizeof(rx));
 264:modules/imu/ins.c ****     tx[0] = (uint8_t)(reg | 0x80u);          /* bit7=1 → 读 */
 265:modules/imu/ins.c **** 
 266:modules/imu/ins.c ****     ins_cs(dev, 1);
 267:modules/imu/ins.c ****     uint8_t st = BSP_IMU_Transfer(tx, rx, n);
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccSX3o5o.s 			page 8


 268:modules/imu/ins.c ****     ins_cs(dev, 0);
 269:modules/imu/ins.c **** 
 270:modules/imu/ins.c ****     if (st == 0u) return 0u;                 /* SPI 失败：数据不可信 */
 271:modules/imu/ins.c **** 
 272:modules/imu/ins.c ****     for (i = 0; i < len; i++) {
 273:modules/imu/ins.c ****         buf[i] = rx[1u + skip + i];
 274:modules/imu/ins.c ****     }
 275:modules/imu/ins.c ****     return 1u;
 276:modules/imu/ins.c **** }
 277:modules/imu/ins.c **** 
 278:modules/imu/ins.c **** static void ins_write(uint8_t dev, uint8_t reg, uint8_t val)
 279:modules/imu/ins.c **** {
 280:modules/imu/ins.c ****     uint8_t tx[2];
 281:modules/imu/ins.c ****     tx[0] = (uint8_t)(reg & 0x7Fu);          /* bit7=0 → 写 */
 282:modules/imu/ins.c ****     tx[1] = val;
 283:modules/imu/ins.c **** 
 284:modules/imu/ins.c ****     ins_cs(dev, 1);
 285:modules/imu/ins.c ****     (void)BSP_IMU_Send(tx, 2);
 286:modules/imu/ins.c ****     ins_cs(dev, 0);
 287:modules/imu/ins.c **** }
 288:modules/imu/ins.c **** 
