  19:modules/imu/ins.c **** /* ======================= 引脚 =======================
  20:modules/imu/ins.c ****  * 片选/模拟开关等片上细节已下沉到 bsp/bsp_spi.c（2026-11-19 P2d），
  21:modules/imu/ins.c ****  * 这里只保留"用哪个器件"的语义。 */
  22:modules/imu/ins.c **** 
  23:modules/imu/ins.c **** /* dev: 0 = 加速度计, 1 = 陀螺 */
  24:modules/imu/ins.c **** #define DEV_ACC   0u
  25:modules/imu/ins.c **** #define DEV_GYRO  1u
  26:modules/imu/ins.c **** 
