 256:modules/ins.c **** 
 257:modules/ins.c **** /**
 258:modules/ins.c ****   * @brief  读寄存器（自动处理 SPI 的「空字节」）
 259:modules/ins.c ****   * @note   哑字节个数取 s_skip_acc / s_skip_gyro（见上方说明）
 260:modules/ins.c ****   */
 261:modules/ins.c **** static uint8_t ins_read(uint8_t dev, uint8_t reg, uint8_t *buf, uint16_t len)
 262:modules/ins.c **** {
 263:modules/ins.c ****     uint8_t  tx[24];
 264:modules/ins.c ****     uint8_t  rx[24];
 265:modules/ins.c ****     uint16_t skip = (dev == DEV_ACC) ? s_skip_acc : s_skip_gyro;
 266:modules/ins.c ****     uint16_t n    = (uint16_t)(1u + skip + len);
 267:modules/ins.c ****     uint16_t i;
 268:modules/ins.c **** 
 269:modules/ins.c ****     if (n > sizeof(tx)) return 0u;
 270:modules/ins.c **** 
 271:modules/ins.c ****     memset(tx, 0, sizeof(tx));
 272:modules/ins.c ****     memset(rx, 0, sizeof(rx));
 273:modules/ins.c ****     tx[0] = (uint8_t)(reg | 0x80u);          /* bit7=1 → 读 */
 274:modules/ins.c **** 
 275:modules/ins.c ****     ins_cs(dev, 1);
 276:modules/ins.c ****     HAL_StatusTypeDef st = HAL_SPI_TransmitReceive(&hspi2, tx, rx, n, 50);
 277:modules/ins.c ****     ins_cs(dev, 0);
 278:modules/ins.c **** 
 279:modules/ins.c ****     if (st != HAL_OK) return 0u;             /* SPI 失败：数据不可信 */
 280:modules/ins.c **** 
 281:modules/ins.c ****     for (i = 0; i < len; i++) {
 282:modules/ins.c ****         buf[i] = rx[1u + skip + i];
 283:modules/ins.c ****     }
 284:modules/ins.c ****     return 1u;
 285:modules/ins.c **** }
 286:modules/ins.c **** 
 287:modules/ins.c **** static void ins_write(uint8_t dev, uint8_t reg, uint8_t val)
 288:modules/ins.c **** {
 289:modules/ins.c ****     uint8_t tx[2];
 290:modules/ins.c ****     tx[0] = (uint8_t)(reg & 0x7Fu);          /* bit7=0 → 写 */
 291:modules/ins.c ****     tx[1] = val;
 292:modules/ins.c **** 
 293:modules/ins.c ****     ins_cs(dev, 1);
 294:modules/ins.c ****     HAL_SPI_Transmit(&hspi2, tx, 2, 20);
 295:modules/ins.c ****     ins_cs(dev, 0);
 296:modules/ins.c **** }
 297:modules/ins.c **** 
 298:modules/ins.c **** /* ======================= 初始化 ======================= */
 299:modules/ins.c **** 
