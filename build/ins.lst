 124:modules/ins.c **** 
 125:modules/ins.c **** /**
 126:modules/ins.c ****   * @brief  读寄存器（自动处理 SPI 的「空字节」）
 127:modules/ins.c ****   * @note   哑字节个数取 s_skip_acc / s_skip_gyro（见上方说明）
 128:modules/ins.c ****   */
 129:modules/ins.c **** static uint8_t ins_read(uint8_t dev, uint8_t reg, uint8_t *buf, uint16_t len)
 130:modules/ins.c **** {
 131:modules/ins.c ****     uint8_t  tx[24];
 132:modules/ins.c ****     uint8_t  rx[24];
 133:modules/ins.c ****     uint16_t skip = (dev == DEV_ACC) ? s_skip_acc : s_skip_gyro;
 134:modules/ins.c ****     uint16_t n    = (uint16_t)(1u + skip + len);
 135:modules/ins.c ****     uint16_t i;
 136:modules/ins.c **** 
 137:modules/ins.c ****     if (n > sizeof(tx)) return 0u;
ARM GAS  C:\Users\elaina\Desktop\STM32.HAL.exercise\Remote_Control\.tmpbuild\ccKlfqTa.s 			page 7


 138:modules/ins.c **** 
 139:modules/ins.c ****     memset(tx, 0, sizeof(tx));
 140:modules/ins.c ****     memset(rx, 0, sizeof(rx));
 141:modules/ins.c ****     tx[0] = (uint8_t)(reg | 0x80u);          /* bit7=1 → 读 */
 142:modules/ins.c **** 
 143:modules/ins.c ****     ins_cs(dev, 1);
 144:modules/ins.c ****     HAL_StatusTypeDef st = HAL_SPI_TransmitReceive(&hspi2, tx, rx, n, 50);
 145:modules/ins.c ****     ins_cs(dev, 0);
 146:modules/ins.c **** 
 147:modules/ins.c ****     if (st != HAL_OK) return 0u;             /* SPI 失败：数据不可信 */
 148:modules/ins.c **** 
 149:modules/ins.c ****     for (i = 0; i < len; i++) {
 150:modules/ins.c ****         buf[i] = rx[1u + skip + i];
 151:modules/ins.c ****     }
 152:modules/ins.c ****     return 1u;
 153:modules/ins.c **** }
 154:modules/ins.c **** 
 155:modules/ins.c **** static void ins_write(uint8_t dev, uint8_t reg, uint8_t val)
 156:modules/ins.c **** {
 157:modules/ins.c ****     uint8_t tx[2];
 158:modules/ins.c ****     tx[0] = (uint8_t)(reg & 0x7Fu);          /* bit7=0 → 写 */
 159:modules/ins.c ****     tx[1] = val;
 160:modules/ins.c **** 
 161:modules/ins.c ****     ins_cs(dev, 1);
 162:modules/ins.c ****     HAL_SPI_Transmit(&hspi2, tx, 2, 20);
 163:modules/ins.c ****     ins_cs(dev, 0);
 164:modules/ins.c **** }
