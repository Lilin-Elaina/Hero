   1:modules/ins.c **** /**
   2:modules/ins.c ****   ******************************************************************************
   3:modules/ins.c ****   * @file    ins.c
   4:modules/ins.c ****   * @brief   BMI088 驱动（SPI2 + 双片选），只做「读角速度」这一件事
   5:modules/ins.c ****   *
   6:modules/ins.c ****   *  片上资源：
   7:modules/ins.c ****   *    SPI2  : PB13=SCK  PC2_C=MISO  PC1=MOSI   （CPOL=High, CPHA=2Edge, 4.125MHz）
   8:modules/ins.c ****   *    CS    : PC0 = 加速度计,  PC3 = 陀螺      （低有效）
   9:modules/ins.c ****   ******************************************************************************
  10:modules/ins.c ****   */
  11:modules/ins.c **** 
  12:modules/ins.c **** #include "ins.h"
  13:modules/ins.c **** #include "spi.h"
  14:modules/ins.c **** #include "main.h"
  15:modules/ins.c **** #include <string.h>
  16:modules/ins.c **** #include <math.h>
  17:modules/ins.c **** 
  18:modules/ins.c **** /* ======================= 引脚 ======================= */
  19:modules/ins.c **** #define INS_CS_PORT        GPIOC
  20:modules/ins.c **** #define INS_CS_ACC_PIN     GPIO_PIN_0
  21:modules/ins.c **** #define INS_CS_GYRO_PIN    GPIO_PIN_3
  22:modules/ins.c **** 
  23:modules/ins.c **** #define INS_CS_ACC_LOW()   HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_ACC_PIN,  GPIO_PIN_RESET)
  24:modules/ins.c **** #define INS_CS_ACC_HIGH()  HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_ACC_PIN,  GPIO_PIN_SET)
  25:modules/ins.c **** #define INS_CS_GYRO_LOW()  HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_GYRO_PIN, GPIO_PIN_RESET)
  26:modules/ins.c **** #define INS_CS_GYRO_HIGH() HAL_GPIO_WritePin(INS_CS_PORT, INS_CS_GYRO_PIN, GPIO_PIN_SET)
  27:modules/ins.c **** 
  28:modules/ins.c **** /* dev: 0 = 加速度计, 1 = 陀螺 */
  29:modules/ins.c **** #define DEV_ACC   0u
  30:modules/ins.c **** #define DEV_GYRO  1u
  31:modules/ins.c **** 
