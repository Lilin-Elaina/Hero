 231:application/robot.c ****     /* ---- CAN2 RX 活性看门狗（2026-11-18）----
 232:application/robot.c ****      * 底盘四轮 + yaw 全在 CAN2，五个节点每个 1kHz 反馈，总线正常时
 233:application/robot.c ****      * can_rx2_total 不可能 20ms 不动。实测出现整条 CAN2 静默 337 秒不恢复：
 234:application/robot.c ****      * 唯一能解释"死透且无人再试"的软件路径 = Bus-Off 回调里 Stop+Start 万一
 235:application/robot.c ****      * 没救回来（ISR 内重启 HAL 状态机有竞态），控制器就永远卡在 CCCR.INIT�
 236:application/robot.c ****      * 而全工程没有任何代码会再试第二次。看门狗补上这一课：
 237:application/robot.c ****      *   - 连续 20ms 无 CAN2 帧 → Stop + FDCAN2_Start 重启一次
 238:application/robot.c ****      *   - 没救回来每 100ms 再试一次
 239:application/robot.c ****      *   - RC_Can2RestartCnt 计数留证：重启后立刻恢复 = 卡死确系软件；
 240:application/robot.c ****      *     重启多少次都没用 = 总线物理上真的死了（回头查硬件）
 241:application/robot.c ****      *   - 只在"上电以来见过总线活着(>1000 帧)"且已使能时启用，
 242:application/robot.c ****      *     避免台架上不带电调时空转重启 */
 243:application/robot.c ****     {
 244:application/robot.c ****         static uint32_t s_can2_last   = 0u;
 245:application/robot.c ****         static uint32_t s_can2_frozen = 0u;
 246:application/robot.c **** 
 247:application/robot.c ****         if (can_rx2_total != s_can2_last)
 248:application/robot.c ****         {
 249:application/robot.c ****             s_can2_last   = can_rx2_total;
 250:application/robot.c ****             s_can2_frozen = 0u;
 251:application/robot.c ****         }
 252:application/robot.c ****         else if ((can_rx2_total > 1000u) && (enabled != 0u))
 253:application/robot.c ****         {
 254:application/robot.c ****             if (s_can2_frozen < 1000000u) s_can2_frozen++;
