  94:application/robot.c ****      * TEC/REC 是 FDCAN 的错误计数器：>127 = 错误被动（收发开始拖延迟重试，
  95:application/robot.c ****      * 表现就是整车“游戏延迟”）；255 = 接近/已 bus-off。
  96:application/robot.c ****      * 之前这只能拿 J-Link 手动读寄存器，现在出问题当场在 Ozone 里定罪。 *
  97:application/robot.c ****     {
  98:application/robot.c ****         uint32_t ecr = hfdcan2.Instance->ECR;
  99:application/robot.c ****         uint32_t tec = ecr & 0xFFu;
 100:application/robot.c ****         uint32_t rec = (ecr >> 8) & 0x7Fu;
 101:application/robot.c **** 
 102:application/robot.c ****         RC_Can2TEC = tec;
 103:application/robot.c ****         RC_Can2REC = rec;
 104:application/robot.c ****         if (tec > RC_Can2TECMax) RC_Can2TECMax = tec;
 105:application/robot.c ****         if (rec > RC_Can2RECMax) RC_Can2RECMax = rec;
 106:application/robot.c ****         RC_Can2PSR  = hfdcan2.Instance->PSR;
 107:application/robot.c ****         RC_Can2CCCR = hfdcan2.Instance->CCCR;
 108:application/robot.c **** 
