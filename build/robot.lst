  47:application/robot.c **** /* ---- CAN2 控制器状态镜像（比 TEC/REC 更能区分“线断了”和“有人应答失�
  48:application/robot.c ****  * PSR.LEC 最后错误码：0=无错 1=填充错 2=格式错 3=ACK错 4=位1错 5=位0错 6=CRC错
  49:application/robot.c ****  *   → 3(ACK)  = 我们发出去了但没有任何节点应答（线断/对端全掉电）
  50:application/robot.c ****  *   → 4/5(位错)= 线上电平与预期不符（短路/终端电阻/收发器坏）
  51:application/robot.c ****  *   → 1/2/6    = 干扰/反射（终端电阻、屏蔽、线长）
  52:application/robot.c ****  * CCCR.INIT=1 → 控制器停在初始化态（Stop 后未重启，或 Bus-Off 恢复失败）*/
  53:application/robot.c **** volatile uint32_t RC_Can2PSR     = 0;
  54:application/robot.c **** volatile uint32_t RC_Can2CCCR    = 0;
  55:application/robot.c **** volatile uint32_t RC_Can2BusOffCnt = 0;   /* Bus-Off 中断次数（bsp.can.c 里 +1） */
  56:application/robot.c **** volatile uint32_t RC_Can2RestartCnt = 0;  /* RX 活性看门狗触发的 Stop+Start 次数 */
