  67:bsp/bsp_uart.c ****         /* 只有真正打开了 D-Cache 才需要做 cache 维护。
  68:bsp/bsp_uart.c ****          * 本工程 D-Cache 关闭（SCB->CCR.DC=0），实测此处若无条件调用
  69:bsp/bsp_uart.c ****          * SCB_InvalidateDCache_by_Addr() 会在第一帧到达时触发
  70:bsp/bsp_uart.c ****          * HardFault（CFSR.IMPRECISERR），导致摇杆永远没反应。 */
  71:bsp/bsp_uart.c ****         if ((SCB->CCR & SCB_CCR_DC_Msk) != 0U)
  72:bsp/bsp_uart.c ****         {
  73:bsp/bsp_uart.c ****             SCB_InvalidateDCache_by_Addr((uint32_t *)dbus_buf, sizeof(dbus_buf));
  74:bsp/bsp_uart.c ****         }
  75:bsp/bsp_uart.c **** 
  76:bsp/bsp_uart.c ****         if ((Size >= BSP_UART_DBUS_FRAME_LEN) && (s_dbus_rx != 0))
  77:bsp/bsp_uart.c ****         {
  78:bsp/bsp_uart.c ****             /* 收到多帧时取最后一帧完整数据 */
  79:bsp/bsp_uart.c ****             s_dbus_rx(&dbus_buf[Size - BSP_UART_DBUS_FRAME_LEN], BSP_UART_DBUS_FRAME_LEN);
