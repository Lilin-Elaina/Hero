   1:bsp/bsp_uart.c **** /**
   2:bsp/bsp_uart.c ****  * @file    bsp_uart.c
   3:bsp/bsp_uart.c ****  * @brief   UART5 + DMA + IDLE 接收（DBUS 遥控器）
   4:bsp/bsp_uart.c ****  * @note    分层：HAL 串口/DMA 细节收在 bsp，模块层只通过
   5:bsp/bsp_uart.c ****  *          BSP_UART_DBusRegisterRx() 拿到“一帧 18 字节”。
   6:bsp/bsp_uart.c ****  *          2026-11-19 从 modules/remote/dbus.c 原样搬迁，接收时序未改。
   7:bsp/bsp_uart.c ****  */
   8:bsp/bsp_uart.c **** #include "main.h"
   9:bsp/bsp_uart.c **** #include "usart.h"
  10:bsp/bsp_uart.c **** #include "bsp_uart.h"
  11:bsp/bsp_uart.c **** 
  12:bsp/bsp_uart.c **** /* DMA 接收缓冲：2 帧容量
  13:bsp/bsp_uart.c ****  *
  14:bsp/bsp_uart.c ****  * ★ 必须放在 DMA 可访问的内存里：STM32H7 的 DTCM(0x20000000) 只有 Cortex-M7
  15:bsp/bsp_uart.c ****  *   的 D-bus 能访问，DMA1/DMA2 往 DTCM 写会在第一个字节就报传输错误。
  16:bsp/bsp_uart.c ****  *   本工程 .data/.bss 都在 DTCMRAM，所以这里显式指定 .dma_buffer 段，
  17:bsp/bsp_uart.c ****  *   该段在 STM32H723xG_flash.ld 里被链接到 RAM_D1(0x24000000)。
  18:bsp/bsp_uart.c ****  *   32 字节对齐是为了将来若打开 D-Cache 仍能安全做 cache 维护。 */
  19:bsp/bsp_uart.c **** #if defined(__GNUC__)
  20:bsp/bsp_uart.c **** static uint8_t dbus_buf[BSP_UART_DBUS_FRAME_LEN * 2]
  21:bsp/bsp_uart.c ****     __attribute__((section(".dma_buffer"), aligned(32)));
  22:bsp/bsp_uart.c **** #else
  23:bsp/bsp_uart.c **** static uint8_t dbus_buf[BSP_UART_DBUS_FRAME_LEN * 2];
  24:bsp/bsp_uart.c **** #endif
  25:bsp/bsp_uart.c **** 
