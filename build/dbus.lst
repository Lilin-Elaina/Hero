 208:Drivers/CMSIS/Include/cachel1_armv7.h ****        *
 209:Drivers/CMSIS/Include/cachel1_armv7.h ****        * When local variables are in stack, after disabling the cache, flush the
 210:Drivers/CMSIS/Include/cachel1_armv7.h ****        * local variables cache line for data consistency.
 211:Drivers/CMSIS/Include/cachel1_armv7.h ****        */
 212:Drivers/CMSIS/Include/cachel1_armv7.h ****       /* Clean and invalidate the local variable cache. */
 213:Drivers/CMSIS/Include/cachel1_armv7.h ****     #if defined(__ICCARM__)
 214:Drivers/CMSIS/Include/cachel1_armv7.h ****     /* As we can't align the stack to the cache line size, invalidate each of the variables */
