  36:modules/remote/dbus.c **** /* DMA 接收缓冲：2 帧容量
  37:modules/remote/dbus.c ****  *
  38:modules/remote/dbus.c ****  * ★ 必须放在 DMA 可访问的内存里：STM32H7 的 DTCM(0x20000000) 只有 Cortex-M7
  39:modules/remote/dbus.c ****  *   的 D-bus 能访问，DMA1/DMA2 往 DTCM 写会在第一个字节就报传输错误。
  40:modules/remote/dbus.c ****  *   本工程 .data/.bss 都在 DTCMRAM，所以这里显式指定 .dma_buffer 段，
  41:modules/remote/dbus.c ****  *   该段在 STM32H723xG_flash.ld 里被链接到 RAM_D1(0x24000000)。
  42:modules/remote/dbus.c ****  *   32 字节对齐是为了将来若打开 D-Cache 仍能安全做 cache 维护。 */
  43:modules/remote/dbus.c **** #if defined(__GNUC__)
  44:modules/remote/dbus.c **** static uint8_t dbus_buf[DBUS_FRAME_LEN * 2]
  45:modules/remote/dbus.c ****     __attribute__((section(".dma_buffer"), aligned(32)));
  46:modules/remote/dbus.c **** #else
  47:modules/remote/dbus.c **** static uint8_t dbus_buf[DBUS_FRAME_LEN * 2];
  48:modules/remote/dbus.c **** #endif
