  79:modules/remote/dbus.c **** 
  80:modules/remote/dbus.c **** /* ------------------------------------------------------------------ */
  81:modules/remote/dbus.c **** /* 18 字节帧完整解析（与大疆官方 sbus_to_rc() 逐位一致）                */
  82:modules/remote/dbus.c **** /*   byte0~5  : 4 路摇杆×11bit + 2 路拨杆×2bit                         */
  83:modules/remote/dbus.c **** /*   byte6~13 : 鼠标 x/y/z + 左右键                                    */
  84:modules/remote/dbus.c **** /*   byte14~15: 键盘按键位图                                           */
  85:modules/remote/dbus.c **** /*   byte16~17: 左拨轮(11bit)                                          */
  86:modules/remote/dbus.c **** /* ------------------------------------------------------------------ */
  87:modules/remote/dbus.c **** /* ------------------------------------------------------------------ */
  88:modules/remote/dbus.c **** /* 拨杆位域自动判定（确定性，不需人工判读）                              */
  89:modules/remote/dbus.c **** /*   实测法：把 DT7 左拨杆停在非中位、右拨杆保持中位，持续 1 秒。        
  90:modules/remote/dbus.c **** /*   这一秒内“稳定处于非中位”的那个位域 = 物理左拨杆 → 自动置 sw_swap
  91:modules/remote/dbus.c **** /*   只在 sw_auto_window_ms 内开放，判定成功即永久锁定。                 */
  92:modules/remote/dbus.c **** /* ------------------------------------------------------------------ */
  93:modules/remote/dbus.c **** #define RC_SW_AUTO_HOLD_MS      1000    /* 条件需连续保持多少毫秒 */
  94:modules/remote/dbus.c **** #define RC_SW_AUTO_WINDOW_MS    3000    /* 上电后多久内允许自动判定 */
  95:modules/remote/dbus.c **** 
  96:modules/remote/dbus.c **** #define RC_OBS_NONE      0              /* 两个位域都在中位 */
  97:modules/remote/dbus.c **** #define RC_OBS_LO_MOVED  1              /* 只有 bit4~5 离开中位 */
  98:modules/remote/dbus.c **** #define RC_OBS_HI_MOVED  2              /* 只有 bit6~7 离开中位 */
  99:modules/remote/dbus.c **** #define RC_OBS_INVALID   3              /* 两个都离开中位 → 本段不计 */
 100:modules/remote/dbus.c **** 
