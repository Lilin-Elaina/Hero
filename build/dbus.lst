  49:modules/remote/dbus.c **** /* ------------------------------------------------------------------ */
  50:modules/remote/dbus.c **** /* 18 字节帧完整解析（与大疆官方 sbus_to_rc() 逐位一致）                */
  51:modules/remote/dbus.c **** /*   byte0~5  : 4 路摇杆×11bit + 2 路拨杆×2bit                         */
  52:modules/remote/dbus.c **** /*   byte6~13 : 鼠标 x/y/z + 左右键                                    */
  53:modules/remote/dbus.c **** /*   byte14~15: 键盘按键位图                                           */
  54:modules/remote/dbus.c **** /*   byte16~17: 左拨轮(11bit)                                          */
  55:modules/remote/dbus.c **** /* 左拨杆在 b[5] 的哪个 2bit 位域，由 dbus.h 的 RC_SW_SWAP 编译期固定：
  56:modules/remote/dbus.c ****  *   0 = bit4~5（官方 s[0]），1 = bit6~7（官方 s[1]）
  57:modules/remote/dbus.c ****  * 不再上电自动判定——换遥控器后若左拨杆失灵，只改那一个宏。 */
  58:modules/remote/dbus.c **** 
