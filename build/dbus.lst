 116:Drivers/CMSIS/Include/cachel1_armv7.h **** {
 117:Drivers/CMSIS/Include/cachel1_armv7.h ****   #if defined (__ICACHE_PRESENT) && (__ICACHE_PRESENT == 1U)
 118:Drivers/CMSIS/Include/cachel1_armv7.h ****     if ( isize > 0 ) {
 119:Drivers/CMSIS/Include/cachel1_armv7.h ****        int32_t op_size = isize + (((uint32_t)addr) & (__SCB_ICACHE_LINE_SIZE - 1U));
 120:Drivers/CMSIS/Include/cachel1_armv7.h ****       uint32_t op_addr = (uint32_t)addr /* & ~(__SCB_ICACHE_LINE_SIZE - 1U) */;
 121:Drivers/CMSIS/Include/cachel1_armv7.h **** 
 122:Drivers/CMSIS/Include/cachel1_armv7.h ****       __DSB();
 123:Drivers/CMSIS/Include/cachel1_armv7.h **** 
 124:Drivers/CMSIS/Include/cachel1_armv7.h ****       do {
 125:Drivers/CMSIS/Include/cachel1_armv7.h ****         SCB->ICIMVAU = op_addr;             /* register accepts only 32byte aligned values, only bi
 126:Drivers/CMSIS/Include/cachel1_armv7.h ****         op_addr += __SCB_ICACHE_LINE_SIZE;
 127:Drivers/CMSIS/Include/cachel1_armv7.h ****         op_size -= __SCB_ICACHE_LINE_SIZE;
 128:Drivers/CMSIS/Include/cachel1_armv7.h ****       } while ( op_size > 0 );
 129:Drivers/CMSIS/Include/cachel1_armv7.h **** 
 130:Drivers/CMSIS/Include/cachel1_armv7.h ****       __DSB();
