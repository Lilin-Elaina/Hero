   7:modules/motor/DJ_Motor.c **** /* 把 32 位中间值夹到 [lo, hi]，再转成 int16_t 打包。
   8:modules/motor/DJ_Motor.c ****  * 形参用 int32_t 是刻意的：若写成 int16_t，超量程的值在调用时就已经被截�
   9:modules/motor/DJ_Motor.c ****  */
  10:modules/motor/DJ_Motor.c **** static inline int16_t clamp_i16(int32_t v, int32_t lo, int32_t hi)
  11:modules/motor/DJ_Motor.c **** {
  12:modules/motor/DJ_Motor.c ****     if (v > hi) { v = hi; }
  13:modules/motor/DJ_Motor.c ****     if (v < lo) { v = lo; }
  14:modules/motor/DJ_Motor.c ****     return (int16_t)v;
  15:modules/motor/DJ_Motor.c **** }
