   2:modules/mecanum.c **** #include "mecanum.h"
   3:modules/mecanum.c **** /* 逆运动学（摇杆指令 → 各轮转速），Vx=前进 Vy=横移(向右为正) Wz=自转(�
   4:modules/mecanum.c ****  *   4 轮麦轮： V_LF = Vx + Vy + Wz      V_RF = Vx - Vy - Wz
   5:modules/mecanum.c ****  *              V_LB = Vx - Vy + Wz      V_RB = Vx + Vy - Wz     
   6:modules/mecanum.c ****  *            （符号见下面的 MECANUM_DIR[]，改装配只改表不改公式）
   7:modules/mecanum.c ****  */
   8:modules/mecanum.c **** #if (MECANUM_WHEEL_NUM == 2)
   9:modules/mecanum.c **** //麦轮方向结构体，设定各轮在各运动状态的旋转方向
  10:modules/mecanum.c **** const Mecanum_Dir_t MECANUM_DIR[MECANUM_WHEEL_NUM] =
  11:modules/mecanum.c **** {
  12:modules/mecanum.c ****     { +1.0f, 0.0f, +1.0f },     /* [0] 左轮 */
  13:modules/mecanum.c ****     { +1.0f, 0.0f, -1.0f },     /* [1] 右轮 */
  14:modules/mecanum.c **** };
  15:modules/mecanum.c **** #else
  16:modules/mecanum.c **** /* 四轮麦轮（X 型辊子）符号表
  17:modules/mecanum.c ****  *   下标顺序 0=左前 1=右前 2=右后 3=左后，与 C620 拨码 ID1/ID2/ID3/ID4 一一对�
  18:modules/mecanum.c ****  *   列含义：fwd = 前进(+x)  strafe = 横移(+y 向左)  spin = 自转(+w 顺时针/右转)
  19:modules/mecanum.c ****  */ 
  20:modules/mecanum.c **** const Mecanum_Dir_t MECANUM_DIR[MECANUM_WHEEL_NUM] =
  21:modules/mecanum.c **** {
  22:modules/mecanum.c ****     { +1.0f, -1.0f, +1.0f },    /* [0] 左前 LF：前进+ 横移+ 自转+ */
  23:modules/mecanum.c ****     { +1.0f, -1.0f, -1.0f },    /* [1] 右前 RF：前进+ 横移- 自转- */
  24:modules/mecanum.c ****     { +1.0f, +1.0f, -1.0f },    /* [2] 右后 RB：前进+ 横移+ 自转- */
  25:modules/mecanum.c ****     { +1.0f, +1.0f, +1.0f },    /* [3] 左后 LB：前进+ 横移- 自转+ */
  26:modules/mecanum.c **** };
  27:modules/mecanum.c **** #endif
