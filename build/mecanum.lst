   2:modules/mecanum.c **** #include "mecanum.h"
   3:modules/mecanum.c **** /*底盘混控 ：归一化目标输入   ，得到各轮归一化指令 */
   4:modules/mecanum.c **** #if (MECANUM_WHEEL_NUM == 4)
   5:modules/mecanum.c **** //麦轮方向结构体，设定各轮在各运动状态的旋转方向
   6:modules/mecanum.c **** 
   7:modules/mecanum.c **** /*
   8:modules/mecanum.c ****  *   列序列 ：fwd  strafe  spin
   9:modules/mecanum.c ****  *    LF = vx - vy - wz
  10:modules/mecanum.c ****  *   RF = vx + vy + wz
  11:modules/mecanum.c ****  *   RB = vx - vy + wz
  12:modules/mecanum.c ****  *   LB = vx + vy - wz
  13:modules/mecanum.c ****  *
  14:modules/mecanum.c ****  *   
  15:modules/mecanum.c ****  */
